    add(r, "71|%s hanya boleh di dalam loop|%s is only allowed inside a loop")
    add(r, "72|fungsi %s butuh %d argumen, tapi diberi %d|function %s needs %d arguments, but got %d")
    add(r, "73|fungsi %s butuh %d sampai %d argumen, tapi diberi %d|function %s needs %d to %d arguments, but got %d")
    add(r, "81|%s di-lock, isinya tidak bisa diubah|%s is locked, its contents cannot be changed")
