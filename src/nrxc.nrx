    add(r, "97|variabel %s sudah ada; lock hanya untuk membuat variabel baru|variable %s already exists; lock is only for creating new variables")
    add(r, "99|for butuh list, teks, atau map; untuk angka pakai range(), contoh: for i in range(10)|for needs a list, text, or map; for numbers use range(), example: for i in range(10)")
    add(r, "100|try harus diikuti catch dengan indent yang sama|try must be followed by catch at the same indent")
    add(r, "104|di dalam options hanya boleh option atau else|only option or else is allowed inside options")
    add(r, "108|return hanya boleh di dalam fungsi|return is only allowed inside a function")
    add(r, "109|catch harus berada tepat setelah blok try|catch must come right after a try block")
    add(r, "110|option harus berada di dalam blok options|option must be inside an options block")
    add(r, "112|perintah ini butuh library window, tambahkan di atas: lib nrx_window|this command needs the window library, add at the top: lib nrx_window")
    add(r, "113|perintah tidak dikenal: %s|unknown command: %s")
    add(r, "114|library %s tidak ditemukan (yang ada: nrx_window, nrx_rand, nrx_crudfile, nrx_keyboard, nrx_console, nrx_sound, nrx_json, nrx_http, nrx_3d, nrx_os, nrx_db)|library %s not found (available: nrx_window, nrx_rand, nrx_crudfile, nrx_keyboard, nrx_console, nrx_sound, nrx_json, nrx_http, nrx_3d, nrx_os, nrx_db)")
    add(r, "118|fungsi %s sudah ada (di %s:%d)|function %s already exists (at %s:%d)")
    add(r, "119|fungsi maksimal punya 8 parameter|a function can have at most 8 parameters")
    add(r, "126|nama %s sudah dipakai fungsi|name %s is already used by a function")
    add(r, "134|%s: file %s tidak ditemukan atau tidak bisa dibuka|%s: file %s not found or cannot be opened")
    add(r, "135|%s: file %s tidak bisa ditulis|%s: file %s cannot be written")
    add(r, "152|choice: list masih kosong|choice: the list is empty")
    add(r, "199|gambar %s tidak ditemukan atau formatnya tidak didukung (pakai PNG, JPG, atau BMP)|image %s not found or its format is not supported (use PNG, JPG, or BMP)")
    add(r, "220|file tidak ditemukan: %s|file not found: %s")
    add(r, "228|isi %s bertipe %s, tidak bisa diisi %s|%s holds %s values, it cannot hold %s")
    add(r, "229|%s bertipe int, tidak bisa diisi angka desimal; pakai int(...) untuk membulatkan ke bawah|%s has type int, it cannot hold a decimal number; use int(...) to round down")
    add(r, "230|%s berisi %s, tidak bisa diisi %s berisi %s|%s holds %s, it cannot be set to a %s of %s")
    add(r, "231|%s bertipe %s, tidak bisa diisi %s|%s has type %s, it cannot hold %s")
    add(r, "233|isi list harus satu jenis, tapi ada %s dan %s|list items must all be one type, but found %s and %s")
