# nrxc.nrx  -  self-hosting TAHAP 5: compiler mini yang ditulis dalam nerx dan menghasilkan
# file .exe Windows 64-bit LANGSUNG (tanpa gcc, tanpa C, tanpa VM, tanpa runtime tambahan).
#
# Bahasa sumber mini (satu perintah per baris, indentasi = spasi; # = komentar):
#     be x = 6 * (2 + 3)            variabel; tipenya ditentukan dari isi pertama (int / string / list)
#     be s = "halo" + " dunia"      string: + menggabung, == dan != membandingkan
#     print x - 4                   cetak int atau string
#     if x > 3                      if / else if / else
#         print "besar"
#     else
#         print "kecil"
#     loop x > 0                    ulangi selama kondisi benar
#         be x = x - 1
#     be xs list int                list kosong: "list int" atau "list string"
#     add(xs, 5)                    tambah di akhir
#     be xs[0] = 7                  ubah isi
#     print xs[0] + len(xs)         baca isi; len() untuk string dan list
#     func ulang(s string, n int) string      fungsi: parameter bertipe, tipe hasil (bawaan: int)
#         ...
#         return hasil
#   Tipe: int, string, list int, list string.  Ekspresi: angka, "teks", variabel, xs[i],
#   fungsi(arg, ...), + - * / %, == != < > <= >=, and, or, not, kurung.
#   type (struct, field 8 byte, nilai = penunjuk ke blok heap; salinan "be b = a" berbagi isi):
#         type Titik                 be p Titik          (blok nol)
#             x int                  be p.x = 3          print p.x
#             nama string            be xs list Titik    add(xs, p)    print xs[0].nama
#   File dan argumen (prelude): bacaFile(nama), tulisFile(nama, isi), argKe(k), cmdLine(), cariS(list, teks)
#   Intrinsik tingkat rendah: alloc(n), free(p), peek8/peek64(p, offset), poke8/poke64(p, offset, nilai),
#   asString(int), asInt(string/list), asListI(int), asListS(int),
#   api(indeks, a1..a7) = panggil fungsi Windows dari tabel impor (lihat OFF_IAT di bawah).
#   Pustaka standar (prelude.nrx, ditulis dalam bahasa ini juga): str, substr, ord, chr, indexOf, ...
#   Memori: delete(x) membebaskan string atau list (data dan kepalanya). Setelah delete, jangan
#   pakai x lagi. Isi list yang berupa string tidak ikut dibebaskan (delete tiap elemen dulu).
#   Intrinsik free(p) membebaskan blok dari alloc(n). Indeks list tidak dicek batasnya.
#
# Pakai:   nerx run src\nrxc.nrx      (lalu isi nama file sumber dan nama .exe)
#          File prelude.nrx harus ada di folder kerja.

lib nrx_crudfile

ffi "kernel32.dll" (
    func CreateFileA(nama string, akses int, bagi int, sa pointer, buat int, atribut int, templ pointer) pointer
    func WriteFile(h pointer, data pointer, n int, tertulis pointer, ov pointer) int
    func CloseHandle(h pointer) int
)

lock HEX = "0123456789ABCDEF"
ffi "kernel32.dll" (
    func lstrcpyA(dst int, src string) int
    func GetCommandLineA() pointer
    func GetUserDefaultUILanguage() int
    func LoadLibraryA(nama string) pointer
    func GetProcAddress(h pointer, nama string) pointer
    func GetModuleFileNameA(h pointer, buf pointer, n int) int
    func GetTempPathA(n int, buf pointer) int
    func GetCurrentProcessId() int
    func DeleteFileA(p string) int
)
ffi "msvcrt.dll" (
    func system(perintah string) int
)
lock ASCII =" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
lock HURUF = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
lock DIGIT = "0123456789"
lock RAW = 512                    # 0x200: ukuran header di file (FileAlignment)
lock BASE_RVA = 4096              # 0x1000: alamat section di memori
lock OFF_ILT = 64                 # 0x40  tabel pencarian impor (6 entri)
lock OFF_IAT = 192                # 0xC0  tabel alamat impor (indeks untuk api(): 0 GetStdHandle 1 WriteFile
                                  #   2 ExitProcess 3 GetProcessHeap 4 HeapAlloc 5 HeapFree 6 CreateFileA
                                  #   7 ReadFile 8 GetFileSize 9 CloseHandle 10 GetCommandLineA
                                  #   11 LoadLibraryA 12 GetProcAddress)
lock NIMPOR = 13

be B = 0                          # buffer seluruh file .exe
be kur = 0                        # kursor penulisan (offset di dalam section)
be tok list string                # token ekspresi yang sedang diurai
be tp = 0                         # posisi token
be noBaris = 0
be berkNama = ""
be dlmFfi = false
# daftar perintah hasil lewatan 1 (satu elemen per baris sumber yang bermakna)
be jenis list string              # p b d s i ei e l f r x
be arg list string
be isiB list string
be isiC list string
be nomor list int
be berk list string
be inden list int
be si = 0                         # perintah yang sedang dikompilasi
be nStmt = 0
# fungsi
be funcNama list string
be funcArity list int
be funcStmt list int
be funcAddr list int
be funcPT list string             # tipe parameter dipisah koma
be funcRet list string
be callPos list int               # tempat disp32 panggilan yang harus ditambal
be callFn list int
be dalamFungsi = false
be curRet = "int"
be curFnNama = ""
be imMuat list string                # file yang sudah dimuat lewat im
be teksOverride = ""                  # kalau tidak kosong: bacaSumber membaca teks ini, bukan file (fungsi buatan compiler)
be retInferensi = ""                  # tipe return yang ditemukan saat menebak tipe hasil fungsi tanpa tipe
# lingkup variabel (program utama atau satu fungsi)
be scNama list string
be scDisp list int
be scTipe list string
be nLokal = 0
# variabel global: semua be/lock di luar fungsi. Slot 8 byte di akhir image, dialamati rip-relatif.
be vbNama list string                   # baris pembuatan pertama tiap variabel (untuk E0343)
be vbBaris list int
be untukFor = false
be gNama list string
be gTipe list string
be gKunci list int                # 1 = lock (tidak boleh diubah)
be gloPos list int                # tempat disp32 yang harus ditambal ke slot global
be gloIdx list int
be globalOK = true                # false untuk fungsi prelude: tidak boleh menyentuh global program
be paksaLokal = false             # true saat menyimpan variabel for di dalam fungsi (selalu lokal)
# break / continue: lompatan yang menunggu ditambal; *Base = tumpukan awal tiap loop yang sedang terbuka
be brkPos list int
be brkBase list int
be cntPos list int
be cntBase list int
# rutin bawaan dan literal string
be offCetak = 0
be offTek = 0
be offStr = 0
be offCetakNL = 0
be offAlloc = 0
be offFree = 0
be posFreeLim = 0
be offApi = 0
be offNL = 0
be offLempar = 0
be offCallp = 0
be optN = 0                       # penghitung nama variabel tersembunyi untuk options
be diam = false                       # true: jangan cetak "Done:" (dipakai nrxc run)
be rtDir = ""                        # folder file runtime (prelude, pustaka, lib\) kalau nrxc.exe dipasang terpisah dari folder kerja
be banyakBerkas = false               # lebih dari satu file sumber pengguna: catat berkas di tiap baris
be metaJenis list string         # templateStyle ("s") dan windowTemplate ("t") yang dibaca dari sumber
be metaNama list string
be metaBody list string           # baris isinya dipisah \n
be metaAktif = false
be libMuat list string            # file library nrx_*.nrx yang sudah dimuat
be tryAktif list int              # slot catat try yang sedang terbuka (disp rbp), dari luar ke dalam
be tryBase list int               # panjang tryAktif saat tiap loop dimulai
# struct (type)
be structNama list string
be structFN list string           # nama field dipisah koma
be structFT list string           # tipe field dipisah titik koma
be structDef list string          # nilai bawaan field dipisah baris baru (kosong = tidak ada)
be typeAktif = ""                 # nama type yang sedang dibaca fieldnya (lewatan 1)
be litTeks list string
be litPos list int
be litIdx list int

# ---------------------------------------------------------------- penulis byte
func w8(o int, v int)
    be x = v
    if x > 127
        be x = x - 256
    poke(B, o, "int8", x)

func w16(o int, v int)
    be x = v
    if x > 32767
        be x = x - 65536
    poke(B, o, "int16", x)

func w32(o int, v int)
    be x = v
    if x > 2147483647
        be x = x - 4294967296
    poke(B, o, "int", x)

func w64(o int, v)
    poke(B, o, "int64", v)

# tulis teks ASCII (kode karakter = posisi di tabel + 32) + byte 0 penutup, mulai di offset file o
func tulisTeks(o int, s string)
    lstrcpyA(B + o, s)                # salin byte apa adanya (UTF-8 utuh) + 0 penutup

# offset section -> offset file
func sek(o int) int
    return RAW + o

# tulis byte dari teks heksadesimal: "48 83 EC 38"
func hex(s string)
    # peephole: "push rax" langsung diikuti "pop rax" / "pop rcx" tidak perlu lewat memori
    if lastPush == kur and kur > barrierKur and (s == "58" or s == "59" or substr(s, 0, 3) == "58 " or substr(s, 0, 3) == "59 ")
        be kur -= 1
        be lastPush = -1
        if substr(s, 0, 2) == "59"
            hex("48 89 C1")               # mov rcx, rax
        if len(s) > 3
            hex(slice(s, 3))
        return
    for t in split(s)
        be v = indexOf(HEX, substr(t, 0, 1)) * 16 + indexOf(HEX, substr(t, 1, 1))
        w8(sek(kur), v)
        be kur += 1
    be lastPush = -1
    if len(s) >= 2 and substr(s, len(s) - 2, 2) == "50" and (len(s) == 2 or substr(s, len(s) - 3, 1) == " ")
        if s != "41 50" and substr(s, 0, 8) != "48 83 EC" and substr(s, 0, 8) != "48 8D 74" and substr(s, 0, 8) != "4C 8D 44" and substr(s, 0, 8) != "4C 8B 4D"
            be lastPush = kur

# posisi terakhir "push rax" yang baru dikeluarkan (= kur kalau instruksi terakhir adalah push rax); barrierKur = target lompatan terakhir
be lastPush = -1
be barrierKur = -1
be kknst = -1                         # nilai konstanta operan kanan terakhir yang dimuat ke rcx oleh gabungKanan (-1 = bukan konstanta)
be kknPos = 0                         # posisi "movabs rcx, konstanta" itu

# M = floor(2^(63+l)/d) + 1 (64 bit tanpa tanda), l = ceil(log2 d), untuk pembagian bertanda 64-bit dengan d konstan
# (Granlund-Montgomery: m' = M - 2^64 sebagai bilangan bertanda punya pola bit yang sama dengan M).
# Pembagian panjang basis 2^15 supaya semua hasil antara kecil (Nerx asli mengubah int besar jadi double);
# hasilnya dua kata 32-bit di magLo dan magHi.
be magLo = 0
be magHi = 0
func hitungMagik(d int, l int)
    be k = 63 + l
    be t = int(floor(k / 15))
    be r = 0
    be lo = 0
    be hi = 0
    for ii in range(t + 1)
        be cur = r * 32768
        if ii == 0
            be cur = cur + int(pow(2, k - t * 15))
        be qd = int(floor(cur / d))
        be r = cur - qd * d
        be lo = lo * 32768 + qd
        be hi = hi * 32768 + int(floor(lo / 4294967296))
        be lo = lo % 4294967296
    be magLo = lo + 1
    be magHi = hi
    if magLo >= 4294967296
        be magLo = 0
        be magHi = hi + 1
# x % d dengan d konstan (2 <= d < 2^31): rax = x -> rax = sisa. Tanpa idiv.
func modKonstan(d int)
    be l = 0
    be p2 = 1
    loop p2 < d
        be p2 = p2 * 2
        be l += 1
    if p2 == d
        hex("48 89 C2 48 C1 FA 3F 48 C1 EA")   # mov rdx, rax; sar rdx, 63; shr rdx, imm8
        w8(sek(kur), 64 - l)
        be kur += 1
        hex("48 01 C2 48 C1 FA")                # add rdx, rax; sar rdx, imm8
        w8(sek(kur), l)
        be kur += 1
        hex("48 C1 E2")                         # shl rdx, imm8
        w8(sek(kur), l)
        be kur += 1
        hex("48 29 D0 50")                      # sub rax, rdx; push rax
        return
    hex("49 89 C0 48 B9")                       # mov r8, rax; movabs rcx, m'
    hitungMagik(d, l)
    w32(sek(kur), magLo)
    w32(sek(kur + 4), magHi)
    be kur += 8
    hex("48 F7 E9 4C 01 C2 48 C1 FA")           # imul rcx; add rdx, r8; sar rdx, imm8
    w8(sek(kur), l - 1)
    be kur += 1
    hex("4C 89 C0 48 C1 F8 3F 48 29 C2")        # mov rax, r8; sar rax, 63; sub rdx, rax   (q = rdx)
    hex("48 69 D2")                             # imul rdx, rdx, d
    d32(d)
    hex("4C 89 C0 48 29 D0 50")                 # mov rax, r8; sub rax, rdx; push rax

func bacaB(o int) int
    be v = peek(B, sek(o), "int8")
    if v < 0
        be v = v + 256
    return v

# operan kanan sudah dihitung di [pR, kur). Kalau isinya hanya "muat nilai lalu push", muat langsung ke rcx
# dan (kalau operan kiri berakhir dengan push) buang push kiri juga: hasil rax = kiri, rcx = kanan tanpa pop.
# false = tidak diubah; pemanggil memakai "pop rcx; pop rax" seperti biasa.
func gabungKanan(pR int, kiriPush bool) bool
    be kknst = -1
    if lastPush != kur or barrierKur >= pR
        return false
    be n = kur - pR
    be glob = false
    if n == 11 and bacaB(pR) == 72 and bacaB(pR + 1) == 184
        w8(sek(pR + 1), 185)              # 48 B8 -> 48 B9 (movabs rcx, imm64)
        be kknst = peek(B, sek(pR + 2), "int64")
        be kknPos = pR
    else if n == 8 and bacaB(pR) == 72 and bacaB(pR + 1) == 139 and (bacaB(pR + 2) == 5 or bacaB(pR + 2) == 133)
        be glob = bacaB(pR + 2) == 5
        w8(sek(pR + 2), bacaB(pR + 2) + 8)    # 05 -> 0D, 85 -> 8D (mov rcx, [..])
    else
        return false
    be kur -= 1                           # buang push kanan
    be lastPush = -1
    if kiriPush
        for k in range(n - 1)
            w8(sek(pR - 1 + k), bacaB(pR + k))
        be kur -= 1                       # buang push kiri
        be kknPos = pR - 1
        if glob
            be gloPos[len(gloPos) - 1] = gloPos[len(gloPos) - 1] - 1
    else
        hex("58")
    return true

# imm32 / disp32 little-endian di posisi kursor
func d32(v int)
    w32(sek(kur), v)
    be kur += 4

# rip-relatif: target = offset section tujuan; disp32 dihitung dari akhir instruksi
func relatif(target int)
    d32(target - (kur + 4))

# tambal lompatan/panggilan: disp32 di posisi p diarahkan ke target
func tambal(p int, target int)
    w32(sek(p), target - (p + 4))
    if target == kur
        be barrierKur = target
        be lastPush = -1

func ratakan(n int, k int) int
    return int(floor((n + k - 1) / k)) * k

func galat(pesan string)
    print "Error " berkNama " baris " noBaris ": " pesan
    exit(1)

# error kompilasi berformat sama dengan Nerx: error E0229 in file.nrx:4: pesan
be errId = false                       # pesan error dalam bahasa Indonesia (errlang = id, atau bahasa Windows)
be errPilih = 0                       # 1 = errlang = id di sumber, 2 = errlang = en, 0 = ikut bahasa Windows

func galatK(kode int, pesan string)
    be ks = str(kode)
    loop len(ks) < 4
        be ks = "0" + ks
    be kata = " in "
    if errId
        be pesan = terjemahPesan(tabelPesanId(), kode, pesan)
        be kata = " di "
    print "error E" + ks + kata + berkNama + ":" + str(noBaris) + ": " + pesan
    exit(1)

# bahasa pesan error: baris "errlang = id/en" di file utama, kalau tidak ada ikut bahasa Windows (seperti Nerx)
func tentukanBahasa(sumber string)
    be errId = (GetUserDefaultUILanguage() % 1024) == 33
    if not fileExists(sumber)
        return
    for baris in split(replace(readFile(sumber), "\r", ""), "\n")
        be b = trim(replace(split(baris, "#")[0], "\t", " "))
        if substr(b, 0, 7) == "errlang" and (len(b) == 7 or substr(b, 7, 1) == " " or substr(b, 7, 1) == "=")
            be v = trim(replace(slice(b, 7), "=", ""))
            if v == "id"
                be errId = true
                be errPilih = 1
            else if v == "en"
                be errId = false
                be errPilih = 2


# terjemahan pesan error ke Indonesia (errlang = id): tabel "kode|indonesia|inggris" dari src\nrx_msgs.h
func isiTemplate(idT string, enT string, pesan string) string
    be segs list string
    be cur = ""
    be i = 0
    loop i < len(enT)
        if substr(enT, i, 1) == "%" and i + 1 < len(enT) and contains("sdc", substr(enT, i + 1, 1))
            add(segs, cur)
            be cur = ""
            be i += 2
        else
            be cur = cur + substr(enT, i, 1)
            be i += 1
    add(segs, cur)
    if len(segs) == 1
        return idT
    if substr(pesan, 0, len(segs[0])) != segs[0]
        return pesan
    be args list string
    be pos = len(segs[0])
    for k in range(1, len(segs))
        be nxt = segs[k]
        if k == len(segs) - 1
            if nxt != "" and slice(pesan, len(pesan) - len(nxt)) != nxt
                return pesan
            add(args, slice(pesan, pos, len(pesan) - len(nxt)))
        else
            be ix = indexOf(slice(pesan, pos), nxt)
            if ix < 0
                return pesan
            add(args, slice(pesan, pos, pos + ix))
            be pos = pos + ix + len(nxt)
    be hasil = ""
    be j = 0
    be ai = 0
    loop j < len(idT)
        if substr(idT, j, 1) == "%" and j + 1 < len(idT) and contains("sdc", substr(idT, j + 1, 1))
            be hasil = hasil + args[ai]
            be ai += 1
            be j += 2
        else
            be hasil = hasil + substr(idT, j, 1)
            be j += 1
    return hasil

func terjemahPesan(tabel list string, kode int, pesan string) string
    be pref = str(kode) + "|"
    for e in tabel
        if substr(e, 0, len(pref)) == pref
            be bag = split(e, "|")
            return isiTemplate(bag[1], bag[2], pesan)
    return pesan
func tabelPesanId() list string
    be r list string
    add(r, "3|variabel %s belum dibuat (kalau maksudnya teks, pakai tanda kutip: \"%s\")|variable %s has not been created (if you meant text, use quotes: \"%s\")")
    add(r, "5|%s di-lock, nilainya tidak bisa diubah|%s is locked, its value cannot be changed")
    add(r, "6|%s butuh %d argumen, tapi diberi %d|%s needs %d arguments, but got %d")
    add(r, "10|ffi: file %s tidak ditemukan|ffi: file %s not found")
    add(r, "20|ffi: fungsi %s tidak ada di %s|ffi: function %s is not in %s")
    add(r, "23|operator %c butuh angka|operator %c needs numbers")
    add(r, "24|tidak bisa dibagi dengan nol|cannot divide by zero")
    add(r, "25|index harus angka|index must be a number")
    add(r, "26|index %d di luar list (isi list ada %d)|index %d is outside the list (the list has %d items)")
    add(r, "29|index %d di luar teks (panjang teks %d)|index %d is outside the text (text length is %d)")
    add(r, "360|pow: bilangan bulat dengan pangkat negatif menghasilkan pecahan, pakai basis desimal, misalnya pow(2.0, -1)|pow: a whole-number base with a negative exponent gives a fraction, use a decimal base, for example pow(2.0, -1)")
    add(r, "361|pow: hasilnya terlalu besar untuk bilangan bulat, pakai basis desimal, misalnya pow(2.0, 70)|pow: the result is too large for a whole number, use a decimal base, for example pow(2.0, 70)")
    add(r, "362|%s(): \"%s\" terlalu besar untuk bilangan bulat|%s(): \"%s\" is too large for a whole number")
    add(r, "27|%s tidak punya field %s|%s has no field %s")
    add(r, "28|key \"%s\" tidak ada di map (cek dulu dengan contains(map, \"%s\"))|key \"%s\" is not in the map (check first with contains(map, \"%s\"))")
    add(r, "30|angka tidak bisa diberi index [ ]|a number cannot be indexed with [ ]")
    add(r, "31|tanda kutip \" belum ditutup|quote \" is not closed")
    add(r, "33|kurang tanda }|missing }")
    add(r, "34|kurang tanda )|missing )")
    add(r, "35|kurang tanda ]|missing ]")
    add(r, "37|kurang tanda ) setelah argumen %s|missing ) after the arguments of %s")
    add(r, "39|tidak dimengerti: %s|not understood: %s")
    add(r, "41|tanda - butuh angka|- needs a number")
    add(r, "42|%s(): \"%s\" bukan angka|%s(): \"%s\" is not a number")
    add(r, "43|argumen pertama %s harus list|the first argument of %s must be a list")
    add(r, "44|%s: isinya di-lock, tidak bisa diubah|%s: its contents are locked and cannot be changed")
    add(r, "46|takeLast: list sudah kosong|takeLast: the list is already empty")
    add(r, "47|%s butuh map: %s({\"a\": 1})|%s needs a map: %s({\"a\": 1})")
    add(r, "48|range butuh 1 sampai 3 argumen: range(akhir), range(awal, akhir), range(awal, akhir, langkah)|range needs 1 to 3 arguments: range(end), range(start, end), range(start, end, step)")
    add(r, "49|range: langkah tidak boleh 0|range: step cannot be 0")
    add(r, "51|sqrt: tidak bisa akar dari angka negatif|sqrt: cannot take the square root of a negative number")
    add(r, "52|round butuh 1 atau 2 argumen: round(angka) atau round(angka, digit)|round needs 1 or 2 arguments: round(number) or round(number, digits)")
    add(r, "54|split butuh 1 atau 2 argumen: split(teks, pemisah)|split needs 1 or 2 arguments: split(text, separator)")
    add(r, "55|join butuh 1 atau 2 argumen: join(list, pemisah)|join needs 1 or 2 arguments: join(list, separator)")
    add(r, "56|replace: teks yang dicari tidak boleh kosong|replace: the text to find cannot be empty")
    add(r, "57|substr butuh 2 atau 3 argumen: substr(teks, mulai, panjang)|substr needs 2 or 3 arguments: substr(text, start, length)")
    add(r, "58|slice butuh 2 atau 3 argumen: slice(list, awal, akhir)|slice needs 2 or 3 arguments: slice(list, start, end)")
    add(r, "59|exit butuh 0 atau 1 argumen: exit() atau exit(kode)|exit needs 0 or 1 arguments: exit() or exit(code)")
    add(r, "66|%s() butuh library file, tambahkan di atas: lib nrx_crudfile|%s() needs the file library, add at the top: lib nrx_crudfile")
    add(r, "67|%s butuh %d nilai (%d field), tapi diberi %d|%s needs %d values (%d fields), but got %d")
