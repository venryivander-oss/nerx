func koleksiStr__map_double(m map double) string
    be ks = keys(m)
    be vs = values(m)
    be r = "{"
    for i in range(len(ks))
        if i > 0
            be r = r + ", "
        be r = r + ks[i] + ": " + dblStr(vs[i])
