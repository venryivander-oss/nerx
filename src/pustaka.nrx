func koleksiStr__map_bool(m map bool) string
    be ks = keys(m)
    be vs = values(m)
    be r = "{"
    for i in range(len(ks))
        if i > 0
            be r = r + ", "
        be r = r + ks[i] + ": " + boolStr(vs[i])
    return r + "}"
# wait(detik): tidur
func wait__int(s int) int
    callp(dllFn("kernel32.dll", "Sleep"), s * 1000)
    return 0

func wait__double(s double) int
    callp(dllFn("kernel32.dll", "Sleep"), int(s * 1000))
    return 0
