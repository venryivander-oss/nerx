# cetak galat yang tidak tertangkap, format sama dengan Nerx: error E#### in berkas:baris: pesan

# terjemahan pesan error ke Indonesia (errlang = id): tabel "kode|indonesia|inggris" dari src\nrx_msgs
func nrxIsiTemplate(idT string, enT string, pesan string) string
    be segs list string
    be cur = ""
    be i = 0
    loop i < len(enT)
        if substr(enT, i, 1) == "%" and i + 1 < len(enT) and contains("sdc", substr(enT, i + 1, 1))
            add(segs, cur)
            be cur = ""
            be i += 2
        else
            be cur = cur + substr(enT, i, 1)
            be i += 1
    add(segs, cur)
    if len(segs) == 1
        return idT
    if substr(pesan, 0, len(segs[0])) != segs[0]
        return pesan
    be args list string
    be pos = len(segs[0])
    for k in range(1, len(segs))
        be nxt = segs[k]
        if k == len(segs) - 1
            if nxt != "" and slice(pesan, len(pesan) - len(nxt)) != nxt
                return pesan
            add(args, slice(pesan, pos, len(pesan) - len(nxt)))
        else
            be ix = indexOf(slice(pesan, pos), nxt)
            if ix < 0
                return pesan
            add(args, slice(pesan, pos, pos + ix))
            be pos = pos + ix + len(nxt)
    be hasil = ""
    be j = 0
    be ai = 0
    loop j < len(idT)
        if substr(idT, j, 1) == "%" and j + 1 < len(idT) and contains("sdc", substr(idT, j + 1, 1))
            be hasil = hasil + args[ai]
            be ai += 1
            be j += 2
        else
            be hasil = hasil + substr(idT, j, 1)
            be j += 1
    return hasil

func nrxTerjemahTabel(tabel list string, kode int, pesan string) string
    be pref = str(kode) + "|"
    for e in tabel
        if substr(e, 0, len(pref)) == pref
            be bag = split(e, "|")
            return nrxIsiTemplate(bag[1], bag[2], pesan)
    return pesan
func nrxTabelId() list string
    be r list string
    add(r, "5|%s di-lock, nilainya tidak bisa diubah|%s is locked, its value cannot be changed")
    add(r, "24|tidak bisa dibagi dengan nol|cannot divide by zero")
    add(r, "241|fungsi %s harus mengembalikan %s, tapi tidak ada return|function %s must return %s, but there is no return")
    add(r, "26|index %d di luar list (isi list ada %d)|index %d is outside the list (the list has %d items)")
    add(r, "29|index %d di luar teks (panjang teks %d)|index %d is outside the text (text length is %d)")
    add(r, "360|pow: bilangan bulat dengan pangkat negatif menghasilkan pecahan, pakai basis desimal, misalnya pow(2.0, -1)|pow: a whole-number base with a negative exponent gives a fraction, use a decimal base, for example pow(2.0, -1)")
    add(r, "361|pow: hasilnya terlalu besar untuk bilangan bulat, pakai basis desimal, misalnya pow(2.0, 70)|pow: the result is too large for a whole number, use a decimal base, for example pow(2.0, 70)")
    add(r, "362|%s(): \"%s\" terlalu besar untuk bilangan bulat|%s(): \"%s\" is too large for a whole number")
    add(r, "28|key \"%s\" tidak ada di map (cek dulu dengan contains(map, \"%s\"))|key \"%s\" is not in the map (check first with contains(map, \"%s\"))")
    add(r, "42|%s(): \"%s\" bukan angka|%s(): \"%s\" is not a number")
    add(r, "44|%s: isinya di-lock, tidak bisa diubah|%s: its contents are locked and cannot be changed")
    add(r, "46|takeLast: list sudah kosong|takeLast: the list is already empty")
    add(r, "49|range: langkah tidak boleh 0|range: step cannot be 0")
    add(r, "51|sqrt: tidak bisa akar dari angka negatif|sqrt: cannot take the square root of a negative number")
    add(r, "56|replace: teks yang dicari tidak boleh kosong|replace: the text to find cannot be empty")
    add(r, "81|%s di-lock, isinya tidak bisa diubah|%s is locked, its contents cannot be changed")
    add(r, "134|%s: file %s tidak ditemukan atau tidak bisa dibuka|%s: file %s not found or cannot be opened")
    add(r, "135|%s: file %s tidak bisa ditulis|%s: file %s cannot be written")
    add(r, "152|choice: list masih kosong|choice: the list is empty")
    add(r, "199|gambar %s tidak ditemukan atau formatnya tidak didukung (pakai PNG, JPG, atau BMP)|image %s not found or its format is not supported (use PNG, JPG, or BMP)")
    add(r, "319|listFiles: folder %s tidak ditemukan|listFiles: folder %s not found")
    add(r, "321|replaceInFile: teks yang dicari tidak boleh kosong|replaceInFile: the text to find cannot be empty")
    return r

# errlang: slot tersembunyi 15 = 1 (id) / 2 (en) kalau diatur di sumber, 0 = ikut bahasa Windows
func nrxBahasaId() bool
    be m = _gget(15)
    if m == 1
        return true
    if m == 2
        return false
    return callp(dllFn("kernel32.dll", "GetUserDefaultUILanguage")) % 1024 == 33

func nrxTerjemah(pesan string, kode int) string
    if kode <= 0 or not nrxBahasaId()
        return pesan
    return nrxTerjemahTabel(nrxTabelId(), kode, pesan)

func nrxGalat(pesan string, kode int, baris int, berkas string)
    be s = "error"
    if kode > 0
        be ks = str(kode)
        loop len(ks) < 4
            be ks = "0" + ks
        be s = s + " E" + ks
    if baris > 0
        if nrxBahasaId()
            be s = s + " di " + berkas + ":" + str(baris)
        else
            be s = s + " in " + berkas + ":" + str(baris)
    be s = s + ": " + pesan
    print s
func arrayDariI(l list int) list double
    be r list double = array(len(l))
    for i in range(len(l))
        be r[i] = l[i]
    return r

func arrayDariD(l list double) list double
    be r list double = array(len(l))
    for i in range(len(l))
        be r[i] = l[i]
    return r

# ---- sh: menjalankan perintah shell (dipakai kata kunci "sh" dan fungsi shText / shCode)
# cd dikerjakan sendiri supaya pindah foldernya menetap; mengembalikan -1 kalau bukan perintah cd
func shCd(perintah string) int
    be c = trim(perintah)
    if c != "cd" and substr(c, 0, 3) != "cd "
        return -1
    be p = trim(slice(c, 2))
    if lower(substr(p, 0, 3)) == "/d "
        be p = trim(slice(p, 3))
    if len(p) >= 2 and substr(p, 0, 1) == "\"" and substr(p, len(p) - 1, 1) == "\""
        be p = substr(p, 1, len(p) - 2)
    if p == ""
        be buf = alloc(1100)
        be n = callp(dllFn("kernel32.dll", "GetCurrentDirectoryA"), 1024, buf)
        print fromCn(buf, n)
        free(buf)
        return 0
    if callp(dllFn("kernel32.dll", "SetCurrentDirectoryA"), cstr(p)) == 0
        print "The system cannot find the path specified."
        return 1
    return 0

# jalankan perintah; hasilnya tampil di layar; kembalikan kode keluar (0 = berhasil)
func shCode(perintah string) int
    be k = shCd(perintah)
    if k >= 0
        return k
    return callp(dllFn("msvcrt.dll", "system"), cstr(perintah))

# jalankan perintah dan kembalikan keluarannya sebagai teks (galat ikut, tanpa \r)
func shText(perintah string) string
    be k = shCd(perintah)
    if k >= 0
        return ""
    be f = callp(dllFn("msvcrt.dll", "_popen"), cstr(perintah + " 2>&1"), cstr("r"))
    if f == 0
        return ""
    be buf = alloc(4200)
    be hasil = ""
    be lagi = true
    loop lagi
        be n = callp(dllFn("msvcrt.dll", "fread"), buf, 1, 4096, f)
        if n <= 0
            be lagi = false
        else
            be hasil = hasil + fromCn(buf, n)
    callp(dllFn("msvcrt.dll", "_pclose"), f)
    free(buf)
    return replace(hasil, "\r", "")

# teks berformat f"...": isinya sudah digabung oleh compiler, fungsi ini hanya meneruskan hasilnya
func fmtTeks(s string) string
    return s

# argumen perintah program: nerx run skrip.nrx a b  ->  args() = ["a", "b"]
func args() list string
    be semua list string
    be cmd = fromC(api(10, 0, 0, 0, 0, 0, 0, 0))
    be n = len(cmd)
    be i = 0
    be pos = 0
    loop i < n
        loop i < n and (substr(cmd, i, 1) == " " or substr(cmd, i, 1) == "\t")
            be i += 1
        if i < n
            be tok = ""
            be dlm = false
            loop i < n and (dlm or (substr(cmd, i, 1) != " " and substr(cmd, i, 1) != "\t"))
                be ch = substr(cmd, i, 1)
                if ch == "\""
                    be dlm = not dlm
                else
                    be tok = tok + ch
                be i += 1
            if pos > 0
                add(semua, tok)
            be pos += 1
    return semua