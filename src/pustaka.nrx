# pustaka.nrx - fungsi string/list tambahan, ditulis dalam subset nerx yang didukung nrxc.
# Nama dengan akhiran __tipe = overload menurut tipe argumen pertama; _aN = menurut jumlah argumen.

func contains__string(s string, t string) bool
    return indexOf(s, t) >= 0

func contains__list_string(xs list string, t string) bool
    return cariS(xs, t) >= 0

func indexOf__list_string(xs list string, t string) int
    return cariS(xs, t)

func ruangKosong(c int) bool
    return c == 32 or c == 9 or c == 10 or c == 13

func trim(s string) string
    be i = 0
    be n = len(s)
    loop i < n and ruangKosong(ord(s, i))
        be i += 1
    be j = n
    loop j > i and ruangKosong(ord(s, j - 1))
        be j -= 1
    return substr(s, i, j - i)

func slice_a2(s string, a int) string
    return slice_a3(s, a, len(s))

func slice_a3(s string, a int, b int) string
    be n = len(s)
    be x = a
    be y = b
    if x < 0
        be x = n + x
    if y < 0
        be y = n + y
    if x < 0
        be x = 0
    if y > n
        be y = n
    if y <= x
        return ""
    return substr(s, x, y - x)

func slice_a2__list_string(xs list string, a int) list string
    return slice_a3__list_string(xs, a, len(xs))

func slice_a3__list_string(xs list string, a int, b int) list string
    be r list string
    be n = len(xs)
    be x = a
    be y = b
    if x < 0
        be x = n + x
    if y < 0
        be y = n + y
    if x < 0
        be x = 0
    if y > n
        be y = n
    for i in range(x, y)
        add(r, xs[i])
    return r

# split(s): pisah menurut spasi/tab/baris baru, buang bagian kosong
func split_a1(s string) list string
    be r list string
    be mulai = 0 - 1
    for i in range(len(s))
        if ruangKosong(ord(s, i))
            if mulai >= 0
                add(r, substr(s, mulai, i - mulai))
                be mulai = 0 - 1
        else if mulai < 0
            be mulai = i
    if mulai >= 0
        add(r, substr(s, mulai, len(s) - mulai))
    return r

func split(s string, sep string) list string
    be r list string
    be m = len(sep)
    if m == 0
        # per byte (seperti nerx asli)
        for k in range(len(s))
            add(r, substr(s, k, 1))
        return r
    be i = 0
    be mulai = 0
    loop i + m <= len(s)
        if substr(s, i, m) == sep
            add(r, substr(s, mulai, i - mulai))
            be i += m
            be mulai = i
        else
            be i += 1
    add(r, substr(s, mulai, len(s) - mulai))
    return r

func join(xs list string, sep string) string
    be r = ""
    for i in range(len(xs))
        if i > 0
            be r = r + sep
        be r = r + xs[i]
    return r

func join_a2__list_int(xs list int, sep string) string
    be r = ""
    for i in range(len(xs))
        if i > 0
            be r = r + sep
        be r = r + str(xs[i])
    return r

func join_a2__list_double(xs list double, sep string) string
    be r = ""
    for i in range(len(xs))
        if i > 0
            be r = r + sep
        be r = r + str(xs[i])
    return r

func replace(s string, a string, b string) string
    be m = len(a)
    if m == 0
        _lemparK(56, "replace: the text to find cannot be empty")
    be r = ""
    be i = 0
    be mulai = 0
    loop i + m <= len(s)
        if substr(s, i, m) == a
            be r = r + substr(s, mulai, i - mulai) + b
            be i += m
            be mulai = i
        else
            be i += 1
    return r + substr(s, mulai, len(s) - mulai)

func reverse(s string) string
    be r = ""
    for i in range(len(s))
        be r = r + substr(s, len(s) - 1 - i, 1)
    return r

func upper(s string) string
    be r = ""
    for i in range(len(s))
        be c = ord(s, i)
        if c >= 97 and c <= 122
            be c -= 32
        be r = r + chr(c)
    return r

func lower(s string) string
    be r = ""
    for i in range(len(s))
        be c = ord(s, i)
        if c >= 65 and c <= 90
            be c += 32
        be r = r + chr(c)
    return r

func fileExists(nama string) bool
    be h = api(6, asInt(nama) + 8, 2147483648, 1, 0, 3, 128, 0)
    if h == 0 - 1
        return false
    api(9, h, 0, 0, 0, 0, 0, 0)
    return true

# floor pada int: pembagian int di nrxc sudah membulat ke bawah
func floor(x int) int
    return x

func int__int(x int) int
    return x

# takeLast: ambil elemen terakhir sekaligus membuangnya dari list (kepala list: [panjang][kapasitas][data])
func idxGalat(i int, n int) int
    _lemparK(26, "index " i " is outside the list (the list has " n " items)")
    return 0

func takeLast__list_int(xs list int) int
    be p = asInt(xs)
    be n = peek64(p, 0)
    if n == 0
        _lemparK(46, "takeLast: the list is already empty")
    be v = peek64(peek64(p, 16), 8 * (n - 1))
    poke64(p, 0, n - 1)
    return v
# ---------------------------------------------------------------- double
# 10^k sebagai double (tepat untuk k sampai 22)
func p10d(k int) double
    be r double = 1
    for i in range(k)
        be r = r * 10
    return r

# pecah double jadi bagian atas (Veltkamp): a = hi + lo, tanpa galat
func splitHi(a double) double
    be t double = 134217729 * a
    return t - (t - a)

# bulatkan(x * 10^kk) ke int terdekat; kalau tepat di tengah, pakai galat perkalian eksak (lalu genap)
func bulatkan(x double, kk int) int
    be y double = x
    be err double = 0
    if kk >= 0 and kk <= 22
        be c double = p10d(kk)
        be pr double = x * c
        be xh double = splitHi(x)
        be xl double = x - xh
        be ch double = splitHi(c)
        be cl double = c - ch
        be err = ((xh * ch - pr) + xh * cl + xl * ch) + xl * cl
        be y = pr
    else if kk < 0 and kk >= 0 - 22
        be c2 double = p10d(0 - kk)
        be q double = x / c2
        be qh double = splitHi(q)
        be ql double = q - qh
        be ch2 double = splitHi(c2)
        be cl2 double = c2 - ch2
        be pq double = q * c2
        be eprod double = ((qh * ch2 - pq) + qh * cl2 + ql * ch2) + ql * cl2
        be r double = (x - pq) - eprod
        be err = r / c2
        be y = q
    else
        # di luar jangkauan eksak: skala bertahap (kurang tepat, jarang terjadi)
        be k2 = kk
        if kk >= 0
            loop k2 > 0
                be langkah = k2
                if langkah > 22
                    be langkah = 22
                be y = y * p10d(langkah)
                be k2 -= langkah
        else
            be k2 = 0 - kk
            loop k2 > 0
                be langkah2 = k2
                if langkah2 > 22
                    be langkah2 = 22
                be y = y / p10d(langkah2)
                be k2 -= langkah2
    be d = int(y)
    be f0 double = y - d
    if f0 > 0.5 or (f0 == 0.5 and (err > 0 or (err == 0 and d % 2 == 1)))
        be d += 1
    return d
func hapusNolBelakang(s string) string
    be j = len(s)
    loop j > 0 and substr(s, j - 1, 1) == "0"
        be j -= 1
    return substr(s, 0, j)

# double -> teks seperti nerx asli: bilangan bulat di bawah 1e15 jadi "5.0", selain itu gaya %.10g
func dblStr(x double) string
    if x != x
        return "nan"
    if x - x != 0
        if x > 0
            return "inf"
        return "-inf"
    if x < 0
        return "-" + dblStr(0 - x)
    if x == 0
        return "0.0"
    if x < 1e15
        be iv = int(x)
        if x == iv
            return str(iv) + ".0"
    # eksponen desimal e: 10^e <= x < 10^(e+1)
    be e = 0
    if x >= 1
        if x < 1e22
            loop x >= p10d(e + 1)
                be e += 1
        else
            be z double = x / 1e22
            be e = 22
            loop z >= 10
                be z = z / 10
                be e += 1
    else
        if x >= 1e-22
            be e = 0 - 1
            loop x < 1 / p10d(0 - e)
                be e -= 1
        else
            be z2 double = x * 1e22
            be e = 0 - 22
            loop z2 < 1
                be z2 = z2 * 10
                be e -= 1
    # 10 angka penting: d = bulatkan(x * 10^(9 - e)), pembulatan setengah ke genap (dihitung eksak)
    be d = bulatkan(x, 9 - e)
    if d >= 10000000000
        be d = 1000000000
        be e += 1
    be ds = str(d)
    if e < 0 - 4 or e >= 10
        be mant = substr(ds, 0, 1)
        be sisa = hapusNolBelakang(slice(ds, 1))
        if sisa != ""
            be mant = mant + "." + sisa
        be ee = e
        be tanda = "+"
        if e < 0
            be ee = 0 - e
            be tanda = "-"
        be es = str(ee)
        if len(es) < 2
            be es = "0" + es
        return mant + "e" + tanda + es
    if e >= 0
        be ip = substr(ds, 0, e + 1)
        be fp = hapusNolBelakang(slice(ds, e + 1))
        if fp == ""
            return ip
        return ip + "." + fp
    be nol = ""
    for i in range(0 - e - 1)
        be nol = nol + "0"
    return "0." + nol + hapusNolBelakang(ds)

func str__double(x double) string
    return dblStr(x)

func floor__double(x double) int
    be i = int(x)
    if x < i
        return i - 1
    return i

func ceil__double(x double) int
    be i = int(x)
    if x > i
        return i + 1
    return i

func float__string(s string) double
    be t = trim(s)
    be i = 0
    be neg = false
    if len(t) > 0 and (substr(t, 0, 1) == "-" or substr(t, 0, 1) == "+")
        be neg = substr(t, 0, 1) == "-"
        be i = 1
    be m = 0
    be k = 0
    be nd = 0
    loop i < len(t) and ord(t, i) >= 48 and ord(t, i) <= 57
        be m = m * 10 + (ord(t, i) - 48)
        be i += 1
        be nd += 1
    if i < len(t) and substr(t, i, 1) == "."
        be i += 1
        loop i < len(t) and ord(t, i) >= 48 and ord(t, i) <= 57
            be m = m * 10 + (ord(t, i) - 48)
            be k += 1
            be i += 1
            be nd += 1
    be ex = 0
    if nd > 0 and i < len(t) and (substr(t, i, 1) == "e" or substr(t, i, 1) == "E")
        be i += 1
        be eneg = false
        if i < len(t) and (substr(t, i, 1) == "-" or substr(t, i, 1) == "+")
            be eneg = substr(t, i, 1) == "-"
            be i += 1
        be ed = 0
        loop i < len(t) and ord(t, i) >= 48 and ord(t, i) <= 57
            be ex = ex * 10 + (ord(t, i) - 48)
            be i += 1
            be ed += 1
        if ed == 0
            be nd = 0
        if eneg
            be ex = 0 - ex
    if nd == 0 or i != len(t)
        _lemparK(42, "float(): \"" + s + "\" is not a number")
    be r double = m
    be e10 = ex - k
    if e10 < 0
        be r = r / p10d(0 - e10)
    else
        be r = r * p10d(e10)
    if neg
        return 0.0 - r
    return r

func fmodD(a double, b double) double
    if b == 0
        _lemparK(24, "cannot divide by zero")
    be q = int(a / b)
    return a - b * q

func round_a2__double(x double, d int) double
    be f double = 1
    if d >= 0
        for i in range(d)
            be f = f * 10
        if x >= 0
            return int(x * f + 0.5) / f
        return int(x * f - 0.5) / f
    for i in range(0 - d)
        be f = f * 10
    if x >= 0
        return int(x / f + 0.5) * f
    return int(x / f - 0.5) * f

func round_a2__int(x int, d int) double
    be y double = x
    return round_a2__double(y, d)

func round__double(x double) int
    if x >= 0
        return int(x + 0.5)
    return int(x - 0.5)

func round__int(x int) int
    return x

# s[i]: satu huruf, galat kalau indeks di luar teks
func idxTeks(s string, i int) string
    if i < 0 or i >= len(s)
        _lemparK(29, "index " i " is outside the text (text length is " len(s) ")")
    return substr(s, i, 1)

func max_a2__int(a int, b int) int
    if a >= b
        return a
    return b

func max_a2__double(a double, b double) double
    if a >= b
        return a
    return b

func min_a2__int(a int, b int) int
    if a <= b
        return a
    return b

func min_a2__double(a double, b double) double
    if a <= b
        return a
    return b

# urutan teks per byte (seperti perbandingan nerx)
func strKurang(a string, b string) bool
    be n = len(a)
    if len(b) < n
        be n = len(b)
    for i in range(n)
        be x = ord(a, i)
        be y = ord(b, i)
        if x != y
            return x < y
    return len(a) < len(b)

func sort__list_int(xs list int) list int
    be r list int
    for x in xs
        add(r, x)
    be i = 1
    loop i < len(r)
        be v = r[i]
        be j = i - 1
        loop j >= 0 and r[j] > v
            be r[j + 1] = r[j]
            be j -= 1
        be r[j + 1] = v
        be i += 1
    return r

func sort__list_double(xs list double) list double
    be r list double
    for x in xs
        add(r, x)
    be i = 1
    loop i < len(r)
        be v = r[i]
        be j = i - 1
        loop j >= 0 and r[j] > v
            be r[j + 1] = r[j]
            be j -= 1
        be r[j + 1] = v
        be i += 1
    return r

func sort__list_string(xs list string) list string
    be r list string
    for x in xs
        add(r, x)
    be i = 1
    loop i < len(r)
        be v = r[i]
        be j = i - 1
        loop j >= 0 and strKurang(v, r[j])
            be r[j + 1] = r[j]
            be j -= 1
        be r[j + 1] = v
        be i += 1
    return r

func max_a3__int(a int, b int, c int) int
    return max_a2__int(max_a2__int(a, b), c)

func max_a3__double(a double, b double, c double) double
    return max_a2__double(max_a2__double(a, b), c)

func max_a4__int(a int, b int, c int, d int) int
    return max_a2__int(max_a2__int(a, b), max_a2__int(c, d))

func max_a4__double(a double, b double, c double, d double) double
    return max_a2__double(max_a2__double(a, b), max_a2__double(c, d))

func min_a3__int(a int, b int, c int) int
    return min_a2__int(min_a2__int(a, b), c)

func min_a3__double(a double, b double, c double) double
    return min_a2__double(min_a2__double(a, b), c)

func min_a4__int(a int, b int, c int, d int) int
    return min_a2__int(min_a2__int(a, b), min_a2__int(c, d))

func min_a4__double(a double, b double, c double, d double) double
    return min_a2__double(min_a2__double(a, b), min_a2__double(c, d))

func max__list_int(xs list int) int
    if len(xs) == 0
        _lempar("max: the list is empty")
    be r = xs[0]
    for x in xs
        if x > r
            be r = x
    return r

func max__list_double(xs list double) double
    if len(xs) == 0
        _lempar("max: the list is empty")
    be r = xs[0]
    for x in xs
        if x > r
            be r = x
    return r

func min__list_int(xs list int) int
    if len(xs) == 0
        _lempar("min: the list is empty")
    be r = xs[0]
    for x in xs
        if x < r
            be r = x
    return r

func min__list_double(xs list double) double
    if len(xs) == 0
        _lempar("min: the list is empty")
    be r = xs[0]
    for x in xs
        if x < r
            be r = x
    return r

# ---- list generik (isi 8 byte; compiler mengatur tipe hasil)
func filledRaw(n int, v int) list int
    be r list int
    for i in range(n)
        add(r, v)
    return r

func sliceList2(xs list int, a int, b int) list int
    be n = len(xs)
    be s = a
    if s < 0
        be s = n + s
    if s < 0
        be s = 0
    if s > n
        be s = n
    be e = b
    if e < 0
        be e = n + e
    if e < 0
        be e = 0
    if e > n
        be e = n
    be r list int
    be i = s
    loop i < e
        add(r, xs[i])
        be i += 1
    return r

func sliceList1(xs list int, a int) list int
    return sliceList2(xs, a, len(xs))

func reverseList(xs list int) list int
    be r list int
    be i = len(xs) - 1
    loop i >= 0
        add(r, xs[i])
        be i -= 1
    return r

func cariI(xs list int, t int) int
    for i in range(len(xs))
        if xs[i] == t
            return i
    return 0 - 1

func range_a1(n int) list int
    return range_a3(0, n, 1)

func range_a2(a int, b int) list int
    return range_a3(a, b, 1)

func range_a3(a int, b int, st int) list int
    if st == 0
        _lemparK(49, "range: step cannot be 0")
    be r list int
    be i = a
    if st > 0
        loop i < b
            add(r, i)
            be i += st
    else
        loop i > b
            add(r, i)
            be i += st
    return r

func peekText_a1(p int) string
    return fromC(p)

func peekText_a2(p int, off int) string
    return fromC(p + off)

func exit_a0() int
    return exit(0)

func join_a1(xs list string) string
    return join(xs, "")

func substr_a2(s string, i int) string
    return substr(s, i, len(s))

# ---- matematika
func pi() double
    return 3.141592653589793

func sqrt__double(x double) double
    if x < 0
        _lemparK(51, "sqrt: cannot take the square root of a negative number")
    return _sqrt(x)

func sqrt__int(x int) double
    return sqrt__double(x)

func sin__double(x double) double
    return _sin(x)

func sin__int(x int) double
    return _sin(x)

func cos__double(x double) double
    return _cos(x)

func cos__int(x int) double
    return _cos(x)

func tan__double(x double) double
    return _tan(x)

func tan__int(x int) double
    return _tan(x)

func atan2_a2__double(y double, x double) double
    return _atan2(y, x)

func atan2_a2__int(y int, x int) double
    return _atan2(y, x)

func pow_a2__int(a int, b int) int
    if b < 0
        _lemparK(360, "pow: a whole-number base with a negative exponent gives a fraction, use a decimal base, for example pow(2.0, -1)")
    be r = 1
    be base = a
    be e = b
    loop e > 0
        if e % 2 == 1
            be ar = r
            if ar < 0
                be ar = 0 - ar
            be ab = base
            if ab < 0
                be ab = 0 - ab
            if ab != 0 and ar > idiv(9223372036854775807, ab)
                _lemparK(361, "pow: the result is too large for a whole number, use a decimal base, for example pow(2.0, 70)")
            be r = r * base
        be e = idiv(e, 2)
        if e > 0
            be ab2 = base
            if ab2 < 0
                be ab2 = 0 - ab2
            if ab2 > 3037000499
                _lemparK(361, "pow: the result is too large for a whole number, use a decimal base, for example pow(2.0, 70)")
            be base = base * base
    return r

func pow_a2__double(a double, b double) double
    if b == 0
        return 1.0
    if a == 0
        return 0.0
    be bi = int(b)
    if bi == b and bi > 0 - 1000000 and bi < 1000000
        be neg = bi < 0
        be e = bi
        if neg
            be e = 0 - e
        be r double = 1
        be base = a
        loop e > 0
            if e % 2 == 1
                be r = r * base
            be base = base * base
            be e = idiv(e, 2)
        if neg
            return 1.0 / r
        return r
    if a < 0
        _lempar("pow: a negative number cannot be raised to a decimal power")
    return _fpow(a, b)

# ---- waktu
func wkt2(n int) string
    if n < 10
        return "0" + str(n)
    return str(n)

func sysWord(b int, o int) int
    return peek8(b, o) + 256 * peek8(b, o + 1)

func time() string
    be b = alloc(32)
    callp(dllFn("kernel32.dll", "GetLocalTime"), b)
    be r = wkt2(sysWord(b, 8)) + ":" + wkt2(sysWord(b, 10)) + ":" + wkt2(sysWord(b, 12))
    free(b)
    return r

func date() string
    be b = alloc(32)
    callp(dllFn("kernel32.dll", "GetLocalTime"), b)
    be r = str(sysWord(b, 0)) + "-" + wkt2(sysWord(b, 2)) + "-" + wkt2(sysWord(b, 6))
    free(b)
    return r

func timer() double
    be b = alloc(64)
    callp(dllFn("kernel32.dll", "GetProcessTimes"), 0 - 1, b, b + 8, b + 16, b + 24)
    callp(dllFn("kernel32.dll", "GetSystemTimeAsFileTime"), b + 40)
    be r double = peek64(b, 40) - peek64(b, 0)
    free(b)
    return r / 10000000.0

func abs__int(a int) int
    if a < 0
        return 0 - a
    return a

func abs__double(a double) double
    if a < 0
        return 0.0 - a
    return a
# ---------------------------------------------------------------- map
# Map = blok 16 byte: [penunjuk list key (list string)] [penunjuk list nilai (8 byte per nilai)]. Urutan key = urutan dimasukkan.
func mapBaru() int
    be p = alloc(16)
    poke64(p, 0, listBaru())
    poke64(p, 8, listBaru())
    return p

# indeks key di map, atau -1
func mapCari(m int, k string) int
    be kp = asListS(peek64(m, 0))
    for i in range(len(kp))
        if strSama(kp[i], k) == 1
            return i
    return 0 - 1

func mapGalat(k string) int
    _lemparK(28, "key \"" k "\" is not in the map (check first with contains(map, \"" k "\"))")
    return 0

func mapGet(m int, k string) int
    be i = mapCari(m, k)
    if i < 0
        mapGalat(k)
    return peek64(peek64(peek64(m, 8), 16), 8 * i)

func mapSet(m int, k string, v int) int
    be i = mapCari(m, k)
    if i >= 0
        poke64(peek64(peek64(m, 8), 16), 8 * i, v)
    else
        listTambah(peek64(m, 0), asInt(k))
        listTambah(peek64(m, 8), v)
    return 0

# key yang belum ada dibuat dengan nilai awal v (untuk be m[k] += x)
func mapDefault(m int, k string, v int) int
    if mapCari(m, k) < 0
        mapSet(m, k, v)
    return 0

func contains__map(m map, k string) bool
    return mapCari(asInt(m), k) >= 0

func keys__map(m map) list string
    be r list string
    be kp = asListS(peek64(asInt(m), 0))
    for i in range(len(kp))
        add(r, kp[i])
    return r

# tipe hasil sebenarnya (list <jenis nilai>) ditentukan compiler
func values__map(m map) list int
    be r list int
    be vl = asListI(peek64(asInt(m), 8))
    for i in range(len(vl))
        add(r, vl[i])
    return r

# keluarkan key, kembalikan nilainya (tipe hasil ditentukan compiler)
func remove__map(m map, k string) int
    be mm = asInt(m)
    be i = mapCari(mm, k)
    if i < 0
        mapGalat(k)
    be kl = peek64(mm, 0)
    be vl = peek64(mm, 8)
    be kd = peek64(kl, 16)
    be vd = peek64(vl, 16)
    be n = peek64(kl, 0)
    be v = peek64(vd, 8 * i)
    for j in range(i, n - 1)
        poke64(kd, 8 * j, peek64(kd, 8 * (j + 1)))
        poke64(vd, 8 * j, peek64(vd, 8 * (j + 1)))
    poke64(kl, 0, n - 1)
    poke64(vl, 0, n - 1)
    return v

# remove(list, i): keluarkan isi index i, kembalikan isinya
func remove__list(xs list, i int) int
    be p = asInt(xs)
    be n = peek64(p, 0)
    if i < 0 or i >= n
        idxGalat(i, n)
    be d = peek64(p, 16)
    be v = peek64(d, 8 * i)
    for j in range(i, n - 1)
        poke64(d, 8 * j, peek64(d, 8 * (j + 1)))
    poke64(p, 0, n - 1)
    return v

func contains__list_double(xs list double, v double) bool
    for x in xs
        if x == v
            return true
    return false

func contains__list_int(xs list int, v int) bool
    for x in xs
        if x == v
            return true
    return false

