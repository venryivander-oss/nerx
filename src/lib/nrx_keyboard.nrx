# nrx_keyboard.nrx - keyboard console. Slot tersembunyi 7 = alamat blok keadaan:
#   [0..255] ditekan sejak dicek, [256..511] ditahan, [512..767] pernah ada "dilepas", [768] console siap (0 belum dicek, 1 ya, 2 tidak), [776] handle input

func kbNama() list string
    return split("left right up down space enter escape esc tab backspace delete shift ctrl alt home end pageup pagedown")

func kbKode() list int
    be v list int
    for k in split("37 39 38 40 32 13 27 27 9 8 46 16 17 18 36 35 33 34")
        add(v, int(k))
    return v

# nama tombol -> kode tombol Windows; 0 kalau tidak dikenal
func kbCari(nama string) int
    be low = lower(nama)
    be n = len(low)
    if n == 1
        be c = ord(low, 0)
        if c >= 97 and c <= 122
            return c - 32
        if c >= 48 and c <= 57
            return c
    if n >= 2 and n <= 3 and ord(low, 0) == 102
        if indexOf("0123456789", substr(low, 1, 1)) >= 0 and (n == 2 or indexOf("0123456789", substr(low, 2, 1)) >= 0)
            be f = int(slice(low, 1))
            if f >= 1 and f <= 12
                return 111 + f
    be nm = kbNama()
    be kd = kbKode()
    for i in range(len(nm))
        if nm[i] == low
            return kd[i]
    return 0

func kbBlok() int
    be b = _gget(7)
    if b == 0
        be b = alloc(960)
        _gset(7, b)
    return b

# ---- Linux: terminal mode mentah (tanpa ICANON dan ECHO, read tidak menunggu). Blok: [784..820) termios asli,
# [824] jumlah byte tertunda, [832] posisi baca, [840..904) byte tertunda dari stdin.
func kbSelesai() int
    be b = _gget(7)
    if _linux() == 1 and b != 0 and peek64(b, 768) == 1
        sysCall(16, 0, 21506, b + 784, 0, 0, 0)
        poke64(b, 768, 2)
    return 0

# satu tombol dari stdin: kode tombol Windows (37 kiri, 38 atas, 13 enter, huruf besar A-Z, ...), 1000 + kode karakter untuk tanda baca, 0 kalau tidak ada
func kbLinuxLe(b int) int
    be pos = peek64(b, 832)
    be n = peek64(b, 824)
    if pos >= n
        be r = sysCall(0, 0, b + 840, 64, 0, 0, 0)
        if r <= 0
            return 0
        poke64(b, 824, r)
        poke64(b, 832, 0)
        be n = r
        be pos = 0
    be c = peek8(b, 840 + pos)
    be pos += 1
    be vk = 1
    if c == 27
        be vk = 27
        if pos < n and (peek8(b, 840 + pos) == 91 or peek8(b, 840 + pos) == 79)
            be pos += 1
            be num = 0
            be akhir = 0
            loop pos < n and akhir == 0
                be d = peek8(b, 840 + pos)
                be pos += 1
                if d >= 48 and d <= 57
                    be num = num * 10 + d - 48
                else if d != 59
                    be akhir = d
            be vk = 1
            if akhir == 65
                be vk = 38
            else if akhir == 66
                be vk = 40
            else if akhir == 67
                be vk = 39
            else if akhir == 68
                be vk = 37
            else if akhir == 72
                be vk = 36
            else if akhir == 70
                be vk = 35
            else if akhir >= 80 and akhir <= 83
                be vk = 112 + akhir - 80
            else if akhir == 126
                if num == 1
                    be vk = 36
                else if num == 3
                    be vk = 46
                else if num == 4
                    be vk = 35
                else if num == 5
                    be vk = 33
                else if num == 6
                    be vk = 34
                else if num >= 15 and num <= 24
                    be fi = num - 15
                    if num >= 17
                        be fi -= 1
                    if num >= 23
                        be fi -= 1
                    be vk = 116 + fi
    else if c == 13 or c == 10
        be vk = 13
    else if c == 9
        be vk = 9
    else if c == 127 or c == 8
        be vk = 8
    else if c == 32
        be vk = 32
    else if c >= 97 and c <= 122
        be vk = c - 32
    else if (c >= 65 and c <= 90) or (c >= 48 and c <= 57)
        be vk = c
    else if c > 32 and c < 127
        be vk = 1000 + c
    poke64(b, 832, pos)
    return vk

func kbSiap() bool
    be b = kbBlok()
    if peek64(b, 768) == 0 and _linux() == 1
        if sysCall(16, 0, 21505, b + 784, 0, 0, 0) == 0
            be t = alloc(64)
            for i in range(36)
                poke8(t, i, peek8(b, 784 + i))
            be lb = peek8(b, 796)
            poke8(t, 12, lb - (idiv(lb, 2) % 2) * 2 - (idiv(lb, 8) % 2) * 8)       # matikan ICANON dan ECHO
            poke8(t, 23, 0)
            poke8(t, 22, 0)
            sysCall(16, 0, 21506, t, 0, 0, 0)
            free(t)
            poke64(b, 768, 1)
        else
            poke64(b, 768, 2)
    if peek64(b, 768) == 0
        be h = api(0, 4294967286, 0, 0, 0, 0, 0, 0)
        poke64(b, 776, h)
        be mode = alloc(8)
        if callp(dllFn("kernel32.dll", "GetConsoleMode"), h, mode) != 0
            poke64(b, 768, 1)
        else
            poke64(b, 768, 2)
        free(mode)
    return peek64(b, 768) == 1

# ambil semua kejadian tombol yang menumpuk, tanpa menunggu
func kbKuras() int
    if not kbSiap()
        return 0
    be b = kbBlok()
    if _linux() == 1
        be vk = kbLinuxLe(b)
        loop vk != 0
            if vk != 1 and vk < 256
                poke8(b, vk, 1)
            be vk = kbLinuxLe(b)
        return 0
    be h = peek64(b, 776)
    be jumlah = alloc(8)
    be rec = alloc(64 * 20 + 16)
    be lagi = true
    loop lagi
        if callp(dllFn("kernel32.dll", "GetNumberOfConsoleInputEvents"), h, jumlah) == 0 or peek64(jumlah, 0) % 4294967296 == 0
            be lagi = false
        else if callp(dllFn("kernel32.dll", "ReadConsoleInputA"), h, rec, 64, jumlah) == 0
            be lagi = false
        else
            for i in range(peek64(jumlah, 0) % 4294967296)
                be o = i * 20
                if peek8(rec, o) == 1 and peek8(rec, o + 1) == 0
                    be vk = peek8(rec, o + 10)
                    if peek8(rec, o + 4) != 0
                        poke8(b, vk, 1)
                        poke8(b, 256 + vk, 1)
                    else
                        poke8(b, 256 + vk, 0)
                        poke8(b, 512 + vk, 1)
    free(jumlah)
    free(rec)
    return 0

func keyPressed(nama string) bool
    be vk = kbCari(nama)
    if vk == 0
        _lempar("unknown key \"" nama "\", examples: \"a\", \"5\", \"left\", \"space\", \"enter\", \"f1\"")
    kbKuras()
    be b = kbBlok()
    be r = peek8(b, vk) != 0 or (peek8(b, 512 + vk) != 0 and peek8(b, 256 + vk) != 0)
    poke8(b, vk, 0)
    return r

# tunggu sampai satu tombol ditekan, hasil = namanya
func getKey() string
    if not kbSiap()
        _lempar("getKey needs a console (it cannot be used when input is redirected from a file)")
    kbKuras()
    be b = kbBlok()
    if _linux() == 1
        be nmL = kbNama()
        be kdL = kbKode()
        loop true
            be v = kbLinuxLe(b)
            if v == 0
                linuxTidur(10)
            else if v >= 1000
                return chr(v - 1000)
            else if v != 1
                if (v >= 65 and v <= 90) or (v >= 48 and v <= 57)
                    return lower(chr(v))
                if v >= 112 and v <= 123
                    return "f" + str(v - 111)
                for i in range(len(nmL))
                    if kdL[i] == v
                        return nmL[i]
    be h = peek64(b, 776)
    be jumlah = alloc(8)
    be rec = alloc(32)
    be nm = kbNama()
    be kd = kbKode()
    loop true
        if callp(dllFn("kernel32.dll", "ReadConsoleInputA"), h, rec, 1, jumlah) == 0
            _lempar("getKey: failed to read the keyboard")
        if peek8(rec, 0) == 1 and peek8(rec, 4) != 0
            be vk = peek8(rec, 10)
            if vk != 16 and vk != 17 and vk != 18
                if (vk >= 65 and vk <= 90) or (vk >= 48 and vk <= 57)
                    return lower(chr(vk))
                if vk >= 112 and vk <= 123
                    return "f" + str(vk - 111)
                for i in range(len(nm))
                    if kd[i] == vk
                        return nm[i]
                be c = peek8(rec, 14)
                if c > 32 and c < 127
                    return chr(c)
    return ""
