# nrx_keyboard.nrx - keyboard console. Slot tersembunyi 7 = alamat blok keadaan:
#   [0..255] ditekan sejak dicek, [256..511] ditahan, [512..767] pernah ada "dilepas", [768] console siap (0 belum dicek, 1 ya, 2 tidak), [776] handle input

func kbNama() list string
    return split("left right up down space enter escape esc tab backspace delete shift ctrl alt home end pageup pagedown")

func kbKode() list int
    be v list int
    for k in split("37 39 38 40 32 13 27 27 9 8 46 16 17 18 36 35 33 34")
        add(v, int(k))
    return v

# nama tombol -> kode tombol Windows; 0 kalau tidak dikenal
func kbCari(nama string) int
    be low = lower(nama)
    be n = len(low)
    if n == 1
        be c = ord(low, 0)
        if c >= 97 and c <= 122
            return c - 32
        if c >= 48 and c <= 57
            return c
    if n >= 2 and n <= 3 and ord(low, 0) == 102
        if indexOf("0123456789", substr(low, 1, 1)) >= 0 and (n == 2 or indexOf("0123456789", substr(low, 2, 1)) >= 0)
            be f = int(slice(low, 1))
            if f >= 1 and f <= 12
                return 111 + f
    be nm = kbNama()
    be kd = kbKode()
    for i in range(len(nm))
        if nm[i] == low
            return kd[i]
    return 0

func kbBlok() int
    be b = _gget(7)
    if b == 0
        be b = alloc(800)
        _gset(7, b)
    return b

func kbSiap() bool
    be b = kbBlok()
    if peek64(b, 768) == 0
        be h = api(0, 4294967286, 0, 0, 0, 0, 0, 0)
        poke64(b, 776, h)
        be mode = alloc(8)
        if callp(dllFn("kernel32.dll", "GetConsoleMode"), h, mode) != 0
            poke64(b, 768, 1)
        else
            poke64(b, 768, 2)
        free(mode)
    return peek64(b, 768) == 1

# ambil semua kejadian tombol yang menumpuk, tanpa menunggu
func kbKuras() int
    if not kbSiap()
        return 0
    be b = kbBlok()
    be h = peek64(b, 776)
    be jumlah = alloc(8)
    be rec = alloc(64 * 20 + 16)
    be lagi = true
    loop lagi
        if callp(dllFn("kernel32.dll", "GetNumberOfConsoleInputEvents"), h, jumlah) == 0 or peek64(jumlah, 0) % 4294967296 == 0
            be lagi = false
        else if callp(dllFn("kernel32.dll", "ReadConsoleInputA"), h, rec, 64, jumlah) == 0
            be lagi = false
        else
            for i in range(peek64(jumlah, 0) % 4294967296)
                be o = i * 20
                if peek8(rec, o) == 1 and peek8(rec, o + 1) == 0
                    be vk = peek8(rec, o + 10)
                    if peek8(rec, o + 4) != 0
                        poke8(b, vk, 1)
                        poke8(b, 256 + vk, 1)
                    else
                        poke8(b, 256 + vk, 0)
                        poke8(b, 512 + vk, 1)
    free(jumlah)
    free(rec)
    return 0

func keyPressed(nama string) bool
    be vk = kbCari(nama)
    if vk == 0
        _lempar("unknown key \"" nama "\", examples: \"a\", \"5\", \"left\", \"space\", \"enter\", \"f1\"")
    kbKuras()
    be b = kbBlok()
    be r = peek8(b, vk) != 0 or (peek8(b, 512 + vk) != 0 and peek8(b, 256 + vk) != 0)
    poke8(b, vk, 0)
    return r

# tunggu sampai satu tombol ditekan, hasil = namanya
func getKey() string
    if not kbSiap()
        _lempar("getKey needs a console (it cannot be used when input is redirected from a file)")
    kbKuras()
    be b = kbBlok()
    be h = peek64(b, 776)
    be jumlah = alloc(8)
    be rec = alloc(32)
    be nm = kbNama()
    be kd = kbKode()
    loop true
        if callp(dllFn("kernel32.dll", "ReadConsoleInputA"), h, rec, 1, jumlah) == 0
            _lempar("getKey: failed to read the keyboard")
        if peek8(rec, 0) == 1 and peek8(rec, 4) != 0
            be vk = peek8(rec, 10)
            if vk != 16 and vk != 17 and vk != 18
                if (vk >= 65 and vk <= 90) or (vk >= 48 and vk <= 57)
                    return lower(chr(vk))
                if vk >= 112 and vk <= 123
                    return "f" + str(vk - 111)
                for i in range(len(nm))
                    if kd[i] == vk
                        return nm[i]
                be c = peek8(rec, 14)
                if c > 32 and c < 127
                    return chr(c)
    return ""
