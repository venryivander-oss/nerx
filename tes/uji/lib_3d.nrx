lib nrx_3d.h
open3d("uji 3d", 320, 200)
camera3d(0, 5, 7, 0, 0, 0)
be n = 0
loop running3d() and n < 3
    be n += 1
    begin3d("skyblue", "white")
    plane(0, 0, 0, 10, 10, "#6b8e23")
    grid(10, 1)
    cube(0, 0.5, 0, 1, 1, 1, "orange")
    cubeWire(0, 0.5, 0, 1, 1, 1, "black")
    sphere(2, 0.5, 0, 0.5, "purple")
    cylinder(-2, 0, 0, 0.5, 0.5, 1, "red")
    push3d()
    move3d(1, 0, 2)
    turn3d("y", 30)
    cube(0, 0.5, 0, 1, 1, 1, "pink")
    pop3d()
    text2d("n " + str(n), 10, 10, 20, "black")
    end3d()
print "frame " n
print frameTime() > 0
print len(mouse3d())
print textWidth2d("abc", 20) > 0
close3d()
print "selesai"