print sort([3, 1, 2, 9, -4])
print sort(["pear", "apple", "fig", "app", "Zed"])
print sort([2.5, 1.5, 3.0])
be text = "the quick fox and the lazy dog and the cat"
be count map int
for w in split(text)
    be count[w] += 1
for w in sort(keys(count))
    if count[w] > 1
        print w ": " count[w]
print max(3, 7) min(2.5, 1.5) abs(-4) abs(-2.5)