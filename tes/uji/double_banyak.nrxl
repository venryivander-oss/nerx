for i in range(1, 150)
    print i / 7
    print i * 1.1
    print 1 / i
    print i * 123456.789
    print i / 1000000
    print i * 10000000000 / 3
    print i / 3000000000
    print i * 0.37 + 1 / i
for i in range(1, 40)
    be p double = 1
    be q double = 1
    for j in range(i)
        be p = p * 10
        be q = q / 10
    print p
    print q
    print p / 3
    print q * 7
    print p + 0.5
    print q - p
for i in range(0, 60)
    print i / 8
    print i * 0.125 + 100000
    print i * 0.5 + 0.00005
    print 1000000000 + i / 2
    print 12345678900 + i / 2