func fakt(n)
    if n <= 1
        return 1
    return n * fakt(n - 1)

func fib(n)
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

func jumlah(a, b)
    return a + b

func garis()
    print "------"

print "faktorial 10: " fakt(10)
print "fib 20: " fib(20)
print jumlah(3, 4)
garis()
