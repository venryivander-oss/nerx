print pi()
print pow(2, 10) pow(2, 0.5) pow(2.5, 2) pow(3, 2.5)
print max(3, 9, 2) max([3, 9, 2]) min([3.5, 1.5]) max(2, 3.5) max(1, 2.5, 2)
