func bagi(a int, b int) int
    return a % b

func cobaReturn(x int) string
    try
        if x > 0
            return "positif"
        throw "tidak positif: " x
    catch e
        return "tangkap " e
    return "tak sampai"

func lemparDalam(n int) int
    if n == 0
        throw "dasar"
    return lemparDalam(n - 1) + 1

try
    print "mulai"
    throw "halo"
    print "tidak tercetak"
catch e
    print "ditangkap: " e

try
    print "aman"
catch e
    print "tidak"
print "setelah aman"

try
    try
        throw "dalam"
    catch a
        print "luar menangkap " a
        throw "lagi " a
catch b
    print "terluar " b

try
    be z = lemparDalam(5)
    print z
catch e
    print "dari fungsi: " e

print cobaReturn(3)
print cobaReturn(-1)

for i in range(5)
    try
        if i == 1
            continue
        if i == 3
            break
        print "i=" i
    catch e
        print "x"
print "keluar loop"

be k = 0
loop k < 4
    be k += 1
    try
        if k % 2 == 0
            throw "genap " k
        print "ganjil " k
    catch pesan
        print pesan

try
    print bagi(7, 0)
catch e
    print "bagi: " e

try
    be q = 1 / 0
    print q
catch e
    print "bagi2: " e

try
    throw "ok"
catch
    print "tanpa nama"

be total = 0
for i in range(3)
    try
        be total += i
        throw "x" i
    catch e
        be total += 100
print total

