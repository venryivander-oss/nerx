func a(n int) int
    return b(n + 1) + 1
func b(n int) int
    return c(n + 1) + 1
func c(n int) int
    return d(n + 1) + 1
func d(n int) int
    return e(n + 1) + 1
func e(n int) int
    return n * 2
func nest(x int) string
    if x > 0
        if x > 10
            if x > 100
                if x > 1000
                    if x > 10000
                        if x > 100000
                            return "enam"
                        return "lima"
                    return "empat"
                return "tiga"
            return "dua"
        return "satu"
    return "nol"
print a(1)
for v in split("0 5 50 500 5000 50000 500000")
    print nest(int(v))