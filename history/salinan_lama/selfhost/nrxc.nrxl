# nrxc.nrxl  -  self-hosting TAHAP 5: compiler mini yang ditulis dalam nrxl dan menghasilkan
# file .exe Windows 64-bit LANGSUNG (tanpa gcc, tanpa C, tanpa VM, tanpa runtime tambahan).
#
# Bahasa sumber mini (satu perintah per baris, indentasi = spasi; # = komentar):
#     be x = 6 * (2 + 3)            variabel; tipenya ditentukan dari isi pertama (int / string / list)
#     be s = "halo" + " dunia"      string: + menggabung, == dan != membandingkan
#     print x - 4                   cetak int atau string
#     if x > 3                      if / else if / else
#         print "besar"
#     else
#         print "kecil"
#     loop x > 0                    ulangi selama kondisi benar
#         be x = x - 1
#     be xs list int                list kosong: "list int" atau "list string"
#     add(xs, 5)                    tambah di akhir
#     be xs[0] = 7                  ubah isi
#     print xs[0] + len(xs)         baca isi; len() untuk string dan list
#     func ulang(s string, n int) string      fungsi: parameter bertipe, tipe hasil (bawaan: int)
#         ...
#         return hasil
#   Tipe: int, string, list int, list string.  Ekspresi: angka, "teks", variabel, xs[i],
#   fungsi(arg, ...), + - * / %, == != < > <= >=, and, or, not, kurung.
#   type (struct, field 8 byte, nilai = penunjuk ke blok heap; salinan "be b = a" berbagi isi):
#         type Titik                 be p Titik          (blok nol)
#             x int                  be p.x = 3          print p.x
#             nama string            be xs list Titik    add(xs, p)    print xs[0].nama
#   File dan argumen (prelude): bacaFile(nama), tulisFile(nama, isi), argKe(k), cmdLine(), cariS(list, teks)
#   Intrinsik tingkat rendah: alloc(n), free(p), peek8/peek64(p, offset), poke8/poke64(p, offset, nilai),
#   asString(int), asInt(string/list), asListI(int), asListS(int),
#   api(indeks, a1..a7) = panggil fungsi Windows dari tabel impor (lihat OFF_IAT di bawah).
#   Pustaka standar (prelude.nrxl, ditulis dalam bahasa ini juga): str, substr, ord, chr, indexOf, ...
#   Memori: delete(x) membebaskan string atau list (data dan kepalanya). Setelah delete, jangan
#   pakai x lagi. Isi list yang berupa string tidak ikut dibebaskan (delete tiap elemen dulu).
#   Intrinsik free(p) membebaskan blok dari alloc(n). Indeks list tidak dicek batasnya.
#
# Pakai:   nrxlang run selfhost\nrxc.nrxl      (lalu isi nama file sumber dan nama .exe)
#          File prelude.nrxl harus ada di folder kerja.

lib nrx_crudfile.h

ffi "kernel32.dll" (
    func CreateFileA(nama string, akses int, bagi int, sa pointer, buat int, atribut int, templ pointer) pointer
    func WriteFile(h pointer, data pointer, n int, tertulis pointer, ov pointer) int
    func CloseHandle(h pointer) int
)

lock HEX = "0123456789ABCDEF"
lock ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
lock HURUF = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
lock DIGIT = "0123456789"
lock RAW = 512                    # 0x200: ukuran header di file (FileAlignment)
lock BASE_RVA = 4096              # 0x1000: alamat section di memori
lock OFF_ILT = 64                 # 0x40  tabel pencarian impor (6 entri)
lock OFF_IAT = 160                # 0xA0  tabel alamat impor (indeks untuk api(): 0 GetStdHandle 1 WriteFile
                                  #   2 ExitProcess 3 GetProcessHeap 4 HeapAlloc 5 HeapFree 6 CreateFileA
                                  #   7 ReadFile 8 GetFileSize 9 CloseHandle 10 GetCommandLineA)
lock NIMPOR = 11

be B = 0                          # buffer seluruh file .exe
be kur = 0                        # kursor penulisan (offset di dalam section)
be tok list string                # token ekspresi yang sedang diurai
be tp = 0                         # posisi token
be noBaris = 0
be berkNama = ""
# daftar perintah hasil lewatan 1 (satu elemen per baris sumber yang bermakna)
be jenis list string              # p b d s i ei e l f r x
be arg list string
be isiB list string
be isiC list string
be nomor list int
be berk list string
be inden list int
be si = 0                         # perintah yang sedang dikompilasi
be nStmt = 0
# fungsi
be funcNama list string
be funcArity list int
be funcStmt list int
be funcAddr list int
be funcPT list string             # tipe parameter dipisah koma
be funcRet list string
be callPos list int               # tempat disp32 panggilan yang harus ditambal
be callFn list int
be dalamFungsi = false
be curRet = "int"
# lingkup variabel (program utama atau satu fungsi)
be scNama list string
be scDisp list int
be scTipe list string
be nLokal = 0
# variabel global: semua be/lock di luar fungsi. Slot 8 byte di akhir image, dialamati rip-relatif.
be gNama list string
be gTipe list string
be gKunci list int                # 1 = lock (tidak boleh diubah)
be gloPos list int                # tempat disp32 yang harus ditambal ke slot global
be gloIdx list int
be globalOK = true                # false untuk fungsi prelude: tidak boleh menyentuh global program
be paksaLokal = false             # true saat menyimpan variabel for di dalam fungsi (selalu lokal)
# break / continue: lompatan yang menunggu ditambal; *Base = tumpukan awal tiap loop yang sedang terbuka
be brkPos list int
be brkBase list int
be cntPos list int
be cntBase list int
# rutin bawaan dan literal string
be offCetak = 0
be offTek = 0
be offStr = 0
be offCetakNL = 0
be offAlloc = 0
be offFree = 0
be posFreeLim = 0
be offApi = 0
be offNL = 0
# struct (type)
be structNama list string
be structFN list string           # nama field dipisah koma
be structFT list string           # tipe field dipisah titik koma
be typeAktif = ""                 # nama type yang sedang dibaca fieldnya (lewatan 1)
be litTeks list string
be litPos list int
be litIdx list int

# ---------------------------------------------------------------- penulis byte
func w8(o int, v int)
    be x = v
    if x > 127
        be x = x - 256
    poke(B, o, "int8", x)

func w16(o int, v int)
    be x = v
    if x > 32767
        be x = x - 65536
    poke(B, o, "int16", x)

func w32(o int, v int)
    be x = v
    if x > 2147483647
        be x = x - 4294967296
    poke(B, o, "int", x)

func w64(o int, v)
    poke(B, o, "int64", v)

# tulis teks ASCII (kode karakter = posisi di tabel + 32) + byte 0 penutup, mulai di offset file o
func tulisTeks(o int, s string)
    be i = 0
    for ch in s
        be k = indexOf(ASCII, ch)
        if k < 0
            if ch == "\n"
                be k = -22
            else
                be k = 31
        w8(o + i, k + 32)
        be i += 1
    w8(o + i, 0)

# offset section -> offset file
func sek(o int) int
    return RAW + o

# tulis byte dari teks heksadesimal: "48 83 EC 38"
func hex(s string)
    for t in split(s)
        be v = indexOf(HEX, substr(t, 0, 1)) * 16 + indexOf(HEX, substr(t, 1, 1))
        w8(sek(kur), v)
        be kur += 1

# imm32 / disp32 little-endian di posisi kursor
func d32(v int)
    w32(sek(kur), v)
    be kur += 4

# rip-relatif: target = offset section tujuan; disp32 dihitung dari akhir instruksi
func relatif(target int)
    d32(target - (kur + 4))

# tambal lompatan/panggilan: disp32 di posisi p diarahkan ke target
func tambal(p int, target int)
    w32(sek(p), target - (p + 4))

func ratakan(n int, k int) int
    return int(floor((n + k - 1) / k)) * k

func galat(pesan string)
    print "Error " berkNama " baris " noBaris ": " pesan
    exit(1)

# ---------------------------------------------------------------- tipe
func tipeList(t string) bool
    return len(t) > 5 and substr(t, 0, 5) == "list "

func harusInt(t string)
    if t != "int"
        galat("butuh int, tetapi tipenya " t)

func harusBool(t string)
    if t != "bool"
        galat("butuh bool (true, false, atau hasil perbandingan), tetapi tipenya " t)

# ---------------------------------------------------------------- ekspresi (parser + pembuat kode)
# Setiap fungsi parser mengembalikan TIPE ekspresi ("int", "string", "list int", "list string").
func pecah(s string) list string
    be hasil list string
    be i = 0
    be n = len(s)
    loop i < n
        be ch = substr(s, i, 1)
        if ch == " "
            be i += 1
        else if ch == "\""
            be j = i + 1
            be lit = ""
            be tutup = false
            loop j < n and not tutup
                be c2 = substr(s, j, 1)
                if c2 == "\\" and j + 1 < n
                    be e2 = substr(s, j + 1, 1)
                    if e2 == "n"
                        be lit = lit + "\n"
                    else
                        be lit = lit + e2
                    be j += 2
                else if c2 == "\""
                    be tutup = true
                    be j += 1
                else
                    be lit = lit + c2
                    be j += 1
            if not tutup
                galat("tanda kutip tidak ditutup")
            add(hasil, "\"" + lit)
            be i = j
        else if contains(DIGIT, ch)
            be j = i
            loop j < n and contains(DIGIT, substr(s, j, 1))
                be j += 1
            add(hasil, slice(s, i, j))
            be i = j
        else if contains(HURUF, ch)
            be j = i
            loop j < n and (contains(HURUF, substr(s, j, 1)) or contains(DIGIT, substr(s, j, 1)))
                be j += 1
            add(hasil, slice(s, i, j))
            be i = j
        else if contains("=!<>", ch)
            if i + 1 < n and substr(s, i + 1, 1) == "="
                add(hasil, slice(s, i, i + 2))
                be i += 2
            else
                add(hasil, ch)
                be i += 1
        else if contains("+-*/%(),[].", ch)
            add(hasil, ch)
            be i += 1
        else
            galat("karakter tidak dikenal: " ch)
    return hasil

func lihat() string
    if tp < len(tok)
        return tok[tp]
    return ""

func maju()
    be tp += 1

func cariFungsi(nama string) int
    be fi = indexOf(funcNama, nama)
    if fi < 0
        galat("fungsi tidak dikenal: " nama)
    return fi

# panggil fungsi bernama (argumen sudah di stack): call, bersihkan argumen, push hasil
func panggilNama(nama string, jumlahArg int)
    be fi = cariFungsi(nama)
    hex("E8")
    add(callPos, kur)
    add(callFn, fi)
    d32(0)
    if jumlahArg > 0
        hex("48 81 C4")                   # add rsp, 8 * jumlahArg
        d32(8 * jumlahArg)
    hex("50")                             # push rax

# ---- variabel: lokal (stack) atau global (slot di image)
# muatVar: push nilai variabel ke stack, hasil = tipenya
func muatVar(nama string) string
    be idx = indexOf(scNama, nama)
    if idx >= 0
        hex("48 8B 85")                   # mov rax, [rbp + disp32]
        d32(scDisp[idx])
        hex("50")
        return scTipe[idx]
    if globalOK
        be gx = indexOf(gNama, nama)
        if gx >= 0
            hex("48 8B 05")               # mov rax, [rip + slot global]
            add(gloPos, kur)
            add(gloIdx, gx)
            d32(0)
            hex("50")
            return gTipe[gx]
    galat("variabel belum dibuat: " nama)
    return "int"

# ---- struct dan akses berantai
func cariStruct(t string) int
    return indexOf(structNama, t)

func fieldIdx(sx int, f string) int
    be nama = split(structFN[sx], ",")
    be k = indexOf(nama, f)
    if k < 0
        galat("type " structNama[sx] " tidak punya field " f)
    return k

func fieldTipe(sx int, k int) string
    be tp2 = split(structFT[sx], ";")
    return tp2[k]

# satu langkah akses di posisi tp: [indeks] atau .field. Nilai penampung ada di stack; ganti dengan hasilnya.
func langkahBaca(tipe string) string
    if lihat() == "["
        if not tipeList(tipe)
            galat("bukan list, tidak bisa diindeks: " tipe)
        maju()
        harusInt(logika())
        if lihat() != "]"
            galat("kurung siku tutup hilang")
        maju()
        hex("59 58 48 8B 40 10 48 8B 04 C8 50")   # pop rcx; pop rax; rax=[rax+16]; rax=[rax+rcx*8]; push rax
        return slice(tipe, 5)
    maju()                                # lewati titik
    be fn = lihat()
    maju()
    be sx = cariStruct(tipe)
    if sx < 0
        galat(tipe " bukan type, tidak punya field " fn)
    be fi = fieldIdx(sx, fn)
    hex("58 48 8B 80")                    # pop rax; mov rax, [rax + disp32]
    d32(8 * fi)
    hex("50")
    return fieldTipe(sx, fi)

# indeks token tepat setelah langkah akses yang dimulai di tp
func batasStep() int
    if lihat() == "."
        return tp + 2
    if lihat() != "["
        galat("akses tidak valid: " lihat())
    be dalam = 0
    be k = tp
    loop k < len(tok)
        if tok[k] == "["
            be dalam += 1
        if tok[k] == "]"
            be dalam -= 1
            if dalam == 0
                return k + 1
        be k += 1
    galat("kurung siku tutup hilang")
    return k

# be a.b[i].c = nilai : akses semua langkah kecuali yang terakhir, lalu simpan
func simpanLval(lhs string, nilai string)
    be tok list string = pecah(lhs)
    be tp = 0
    be nm = lihat()
    maju()
    be tipe = muatVar(nm)
    loop batasStep() != len(tok)
        be tipe = langkahBaca(tipe)
    if lihat() == "."
        maju()
        be fn = lihat()
        maju()
        be sx = cariStruct(tipe)
        if sx < 0
            galat(tipe " bukan type, tidak punya field " fn)
        be fi = fieldIdx(sx, fn)
        be tf = fieldTipe(sx, fi)
        be tv = ekspresiDari(nilai)
        if tv != tf
            galat("field " fn " bertipe " tf ", nilai bertipe " tv)
        hex("5A 58 48 89 90")             # pop rdx; pop rax; mov [rax + disp32], rdx
        d32(8 * fi)
    else
        if not tipeList(tipe)
            galat("bukan list, tidak bisa diindeks: " tipe)
        maju()
        harusInt(logika())
        if lihat() != "]"
            galat("kurung siku tutup hilang")
        maju()
        if tp < len(tok)
            galat("sisa token tidak terpakai: " lihat())
        be tv = ekspresiDari(nilai)
        if tv != slice(tipe, 5)
            galat("isi list bertipe " slice(tipe, 5) ", nilai bertipe " tv)
        hex("5A 59 58 48 8B 40 10 48 89 14 C8")   # pop rdx; pop rcx; pop rax; rax=[rax+16]; [rax+rcx*8]=rdx

# faktor: angka | "teks" | variabel | a[i] | a.field | fungsi(arg, ...) | ( ekspresi ) | - faktor | not faktor
func faktor() string
    be t = lihat()
    be hasil = "int"
    if t == ""
        galat("ekspresi belum lengkap")
    if t == "("
        maju()
        be hasil = logika()
        if lihat() != ")"
            galat("kurung tutup hilang")
        maju()
    else if t == "-"
        maju()
        harusInt(faktor())
        hex("58 48 F7 D8 50")             # pop rax; neg rax; push rax
    else if t == "not"
        maju()
        harusBool(faktor())
        hex("58 48 85 C0 0F 94 C0 0F B6 C0 50")   # pop rax; test; sete al; movzx eax, al; push rax
        be hasil = "bool"
    else if substr(t, 0, 1) == "\""
        maju()
        add(litTeks, slice(t, 1))
        hex("48 8D 05")                   # lea rax, [literal]  (alamat ditambal di akhir)
        add(litPos, kur)
        add(litIdx, len(litTeks) - 1)
        d32(0)
        hex("50")
        be hasil = "string"
    else if contains(DIGIT, substr(t, 0, 1))
        maju()
        hex("48 B8")                      # mov rax, imm64
        w64(sek(kur), int(t))
        be kur += 8
        hex("50")                         # push rax
    else if contains(HURUF, substr(t, 0, 1))
        maju()
        if t == "true"
            hex("6A 01")                  # push 1
            be hasil = "bool"
        else if t == "false"
            hex("6A 00")                  # push 0
            be hasil = "bool"
        else if lihat() == "("
            be hasil = panggil(t)
        else
            be hasil = muatVar(t)
            loop lihat() == "[" or lihat() == "."
                be hasil = langkahBaca(hasil)
    else
        galat("token tidak terduga: " t)
    return hasil

# pemanggilan: intrinsik atau fungsi buatan. Argumen dihitung kiri ke kanan dan ditaruh di stack.
func panggil(nama string) string
    maju()                                # lewati (
    be tipeArg list string
    if lihat() != ")"
        be terus = true
        loop terus
            add(tipeArg, logika())
            if lihat() == ","
                maju()
            else
                be terus = false
    if lihat() != ")"
        galat("kurung tutup hilang pada pemanggilan " nama)
    maju()
    be n = len(tipeArg)
    # --- intrinsik
    if nama == "alloc"
        if n != 1 or tipeArg[0] != "int"
            galat("alloc(n int)")
        hex("59 E8")                      # pop rcx; call alloc
        relatif(offAlloc)
        hex("50")
        return "int"
    if nama == "free"
        if n != 1 or tipeArg[0] != "int"
            galat("free(p int)")
        hex("59 E8")                      # pop rcx; call free
        relatif(offFree)
        hex("6A 00")                      # push 0
        return "int"
    if nama == "api"
        # api(indeks, a1..a7): panggil fungsi Windows lewat tabel impor; semua int; hasil rax
        if n != 8
            galat("api(indeks, a1, a2, a3, a4, a5, a6, a7) butuh 8 argumen")
        for k in range(8)
            if tipeArg[k] != "int"
                galat("semua argumen api() harus int")
        hex("E8")
        relatif(offApi)
        hex("48 81 C4")                   # add rsp, 64
        d32(64)
        hex("50")
        return "int"
    # --- konstruktor type: Titik(1, 2) = satu nilai per field, sesuai urutan
    be sc2 = cariStruct(nama)
    if sc2 >= 0
        be nmF = split(structFN[sc2], ",")
        be tpF = split(structFT[sc2], ";")
        if n != len(nmF)
            galat(nama " butuh " len(nmF) " nilai (satu per field), diberi " n)
        for k in range(n)
            if tpF[k] != tipeArg[k]
                galat("nilai ke-" (k + 1) " untuk " nama " harus " tpF[k] ", bukan " tipeArg[k])
        hex("B9")                         # mov ecx, ukuran blok
        d32(8 * n)
        hex("E8")                         # call alloc
        relatif(offAlloc)
        for k in range(n)
            hex("5A 48 89 90")            # pop rdx; mov [rax + disp32], rdx   (dari field terakhir)
            d32(8 * (n - 1 - k))
        hex("50")
        return nama
    if nama == "peek8" or nama == "peek64"
        if n != 2 or tipeArg[0] != "int" or tipeArg[1] != "int"
            galat(nama "(p int, offset int)")
        if nama == "peek8"
            hex("59 58 0F B6 04 08 50")   # movzx eax, byte [rax+rcx]
        else
            hex("59 58 48 8B 04 08 50")   # mov rax, [rax+rcx]
        return "int"
    if nama == "poke8" or nama == "poke64"
        if n != 3 or tipeArg[0] != "int" or tipeArg[1] != "int" or tipeArg[2] != "int"
            galat(nama "(p int, offset int, nilai int)")
        if nama == "poke8"
            hex("5A 59 58 88 14 08 6A 00")      # mov [rax+rcx], dl; push 0
        else
            hex("5A 59 58 48 89 14 08 6A 00")   # mov [rax+rcx], rdx; push 0
        return "int"
    if nama == "asString" or nama == "asListI" or nama == "asListS"
        if n != 1 or tipeArg[0] != "int"
            galat(nama "(p int)")
        if nama == "asString"
            return "string"
        if nama == "asListI"
            return "list int"
        return "list string"
    if nama == "asInt"
        if n != 1 or (tipeArg[0] != "string" and not tipeList(tipeArg[0]))
            galat("asInt(string atau list)")
        return "int"
    if nama == "len"
        if n != 1 or (tipeArg[0] != "string" and not tipeList(tipeArg[0]))
            galat("len(string atau list)")
        hex("58 48 8B 00 50")             # pop rax; mov rax, [rax]; push rax
        return "int"
    if nama == "add"
        if n != 2 or not tipeList(tipeArg[0])
            galat("add(list, nilai)")
        if tipeArg[1] != slice(tipeArg[0], 5)
            galat("add: isi list bertipe " slice(tipeArg[0], 5) ", nilai bertipe " tipeArg[1])
        panggilNama("listTambah", 2)
        return "int"
    # --- fungsi buatan (termasuk prelude / pustaka). Nama bisa di-overload menurut tipe argumen pertama:
    #     contains__string, contains__list_string, slice__list, ... dicoba lebih dulu daripada nama polos.
    be nm2 = nama
    if indexOf(funcNama, nama + "_a" + str(n)) >= 0
        be nm2 = nama + "_a" + str(n)       # overload menurut jumlah argumen: slice_a2, slice_a3
    else if n > 0
        be cand1 = nama + "__" + replace(tipeArg[0], " ", "_")
        if indexOf(funcNama, cand1) >= 0
            be nm2 = cand1
        else if tipeList(tipeArg[0]) and indexOf(funcNama, nama + "__list") >= 0
            be nm2 = nama + "__list"
    be fi = cariFungsi(nm2)
    if n != funcArity[fi]
        galat("fungsi " nama " butuh " funcArity[fi] " argumen, diberi " n)
    if n > 0
        be tipeParam = split(funcPT[fi], ",")
        for k in range(n)
            if tipeParam[k] == "list" and tipeList(tipeArg[k])
                be okParam = true         # parameter bertipe "list" menerima list apa pun
            else if tipeParam[k] != tipeArg[k]
                galat("argumen ke-" (k + 1) " untuk " nama " harus " tipeParam[k] ", bukan " tipeArg[k])
    panggilNama(nm2, n)
    # tipe hasil khusus: "list" = tipe argumen pertama, "elem" = tipe isi list argumen pertama
    if funcRet[fi] == "list"
        return tipeArg[0]
    if funcRet[fi] == "elem"
        return slice(tipeArg[0], 5)
    return funcRet[fi]

# suku: faktor { (* | / | %) faktor }
func suku() string
    be tl = faktor()
    loop lihat() == "*" or lihat() == "/" or lihat() == "%"
        be op = lihat()
        maju()
        be tr = faktor()
        harusInt(tl)
        harusInt(tr)
        hex("59 58")                      # pop rcx (kanan); pop rax (kiri)
        if op == "*"
            hex("48 0F AF C1 50")         # imul rax, rcx; push rax
        else if op == "/"
            hex("48 99 48 F7 F9 50")      # cqo; idiv rcx; push rax (hasil bagi)
        else
            hex("48 99 48 F7 F9 52")      # cqo; idiv rcx; push rdx (sisa bagi)
    return tl

# ekspresi: suku { (+ | -) suku }     (+ juga menggabung string)
func ekspresi() string
    be tl = suku()
    loop lihat() == "+" or lihat() == "-"
        be op = lihat()
        maju()
        be tr = suku()
        if op == "+" and tl == "string" and tr == "string"
            panggilNama("strGabung", 2)
        else
            harusInt(tl)
            harusInt(tr)
            hex("59 58")                  # pop rcx; pop rax
            if op == "+"
                hex("48 01 C8 50")        # add rax, rcx; push rax
            else
                hex("48 29 C8 50")        # sub rax, rcx; push rax
    return tl

# bandingkan: ekspresi [ (== != < > <= >=) ekspresi ]  -> int 1 atau 0
func bandingkan() string
    be tl = ekspresi()
    be op = lihat()
    if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">="
        maju()
        be tr = ekspresi()
        if tl == "string" and tr == "string"
            if op != "==" and op != "!="
                galat("string hanya bisa dibandingkan dengan == dan !=")
            panggilNama("strSama", 2)
            if op == "!="
                hex("58 48 83 F0 01 50")  # pop rax; xor rax, 1; push rax
            return "bool"
        harusInt(tl)
        harusInt(tr)
        be sc = "94"
        if op == "!="
            be sc = "95"
        if op == "<"
            be sc = "9C"
        if op == ">"
            be sc = "9F"
        if op == "<="
            be sc = "9E"
        if op == ">="
            be sc = "9D"
        hex("59 58 48 39 C8")             # pop rcx; pop rax; cmp rax, rcx
        hex("0F " + sc + " C0 0F B6 C0 50")   # setcc al; movzx eax, al; push rax
        return "bool"
    return tl

# logika: bandingkan { (and | or) bandingkan }
func logika() string
    be tl = bandingkan()
    loop lihat() == "and" or lihat() == "or"
        be op = lihat()
        maju()
        be tr = bandingkan()
        harusBool(tl)
        harusBool(tr)
        hex("59 58")
        if op == "and"
            hex("48 21 C8 50")            # and rax, rcx; push rax
        else
            hex("48 09 C8 50")            # or rax, rcx; push rax
    return tl

# urai satu ekspresi dari teks; kode hasilnya meninggalkan nilai di puncak stack. Hasil: tipenya.
func ekspresiDari(s string) string
    be tok list string = pecah(s)
    be tp = 0
    be tipe = logika()
    if tp < len(tok)
        galat("sisa token tidak terpakai: " lihat())
    return tipe

# ---------------------------------------------------------------- rutin bawaan (kode mesin)
# Semua rutin menyejajarkan stack sendiri bila perlu, jadi aman dipanggil dari mana saja.

# cetak: rax = bilangan bertanda -> tulis desimal + baris baru ke stdout (handle di rbx)
func rutinCetak()
    hex("56")                             # push rsi
    hex("55")                             # push rbp
    hex("48 89 E5")                       # mov rbp, rsp
    hex("48 83 E4 F0")                    # and rsp, -16
    hex("48 83 EC 50")                    # sub rsp, 0x50   (shadow 0x20, arg5 0x20, written 0x30, buffer 0x38..0x4F)
    hex("48 8D 74 24 50")                 # lea rsi, [rsp+0x50]   (ujung buffer)
    hex("45 31 D2")                       # xor r10d, r10d        (penanda negatif)
    hex("48 85 C0")                       # test rax, rax
    hex("79 09")                          # jns +9
    hex("48 F7 D8")                       # neg rax
    hex("41 BA 01 00 00 00")              # mov r10d, 1
    hex("B9 0A 00 00 00")                 # mov ecx, 10
    hex("31 D2")                          # .loop: xor edx, edx
    hex("48 F7 F1")                       # div rcx
    hex("80 C2 30")                       # add dl, '0'
    hex("48 FF CE")                       # dec rsi
    hex("88 16")                          # mov [rsi], dl
    hex("48 85 C0")                       # test rax, rax
    hex("75 EE")                          # jnz .loop (-18)
    hex("45 85 D2")                       # test r10d, r10d
    hex("74 06")                          # jz +6
    hex("48 FF CE")                       # dec rsi
    hex("C6 06 2D")                       # mov byte [rsi], '-'
    hex("4C 8D 44 24 50")                 # lea r8, [rsp+0x50]
    hex("49 29 F0")                       # sub r8, rsi           (panjang)
    hex("48 89 F2")                       # mov rdx, rsi          (alamat)
    hex("48 89 D9")                       # mov rcx, rbx          (handle)
    hex("4C 8D 4C 24 30")                 # lea r9, [rsp+0x30]
    hex("48 C7 44 24 20 00 00 00 00")     # mov qword [rsp+0x20], 0
    hex("FF 15")                          # call [WriteFile]
    relatif(OFF_IAT + 8)
    hex("48 89 EC")                       # mov rsp, rbp
    hex("5D")                             # pop rbp
    hex("5E")                             # pop rsi
    hex("C3")                             # ret

# cetakTeks: rdx = alamat teks, r8 = panjang -> tulis ke stdout
func rutinCetakTeks()
    hex("55")                             # push rbp
    hex("48 89 E5")                       # mov rbp, rsp
    hex("48 83 E4 F0")                    # and rsp, -16
    hex("48 83 EC 40")                    # sub rsp, 0x40
    hex("48 89 D9")                       # mov rcx, rbx
    hex("4C 8D 4C 24 30")                 # lea r9, [rsp+0x30]
    hex("48 C7 44 24 20 00 00 00 00")     # mov qword [rsp+0x20], 0
    hex("FF 15")                          # call [WriteFile]
    relatif(OFF_IAT + 8)
    hex("48 89 EC")                       # mov rsp, rbp
    hex("5D")                             # pop rbp
    hex("C3")                             # ret

# cetakStr: rax = string (panjang di [rax], isi di rax+8) -> tulis isi (tanpa baris baru)
func rutinCetakStr()
    hex("48 89 C2")                       # mov rdx, rax
    hex("48 83 C2 08")                    # add rdx, 8
    hex("4C 8B 00")                       # mov r8, [rax]
    hex("E9")                             # jmp cetakTeks (tail call)
    relatif(offTek)

# cetakNL: tulis satu baris baru
func rutinCetakNL()
    hex("48 8D 15")                       # lea rdx, [baris baru]
    relatif(offNL)
    hex("41 B8 01 00 00 00")              # mov r8d, 1
    hex("E9")                             # jmp cetakTeks (tail call)
    relatif(offTek)

# alloc: rcx = ukuran -> rax = alamat blok baru yang berisi nol (HeapAlloc dari heap proses)
func rutinAlloc()
    hex("55")                             # push rbp
    hex("48 89 E5")                       # mov rbp, rsp
    hex("48 83 E4 F0")                    # and rsp, -16
    hex("48 83 EC 40")                    # sub rsp, 0x40
    hex("48 89 4C 24 30")                 # mov [rsp+0x30], rcx   (simpan ukuran)
    hex("FF 15")                          # call [GetProcessHeap]
    relatif(OFF_IAT + 24)
    hex("48 89 C1")                       # mov rcx, rax          (heap)
    hex("BA 08 00 00 00")                 # mov edx, 8            (HEAP_ZERO_MEMORY)
    hex("4C 8B 44 24 30")                 # mov r8, [rsp+0x30]    (ukuran)
    hex("FF 15")                          # call [HeapAlloc]
    relatif(OFF_IAT + 32)
    hex("48 89 EC")                       # mov rsp, rbp
    hex("5D")                             # pop rbp
    hex("C3")                             # ret

# free: rcx = alamat blok dari alloc -> kembalikan ke heap proses
func rutinFree()
    # alamat di dalam image .exe (literal string) bukan dari heap: abaikan, jangan dibebaskan
    hex("48 89 C8")                       # mov rax, rcx
    hex("48 BA")                          # mov rdx, 0x140001000 (awal section)
    w64(sek(kur), 5368713216)
    be kur += 8
    hex("48 29 D0")                       # sub rax, rdx
    hex("48 3D")                          # cmp rax, ukuran image (ditambal di akhir)
    be posFreeLim = kur
    d32(0)
    hex("73 01 C3")                       # jae +1 ; ret   (di dalam image -> langsung kembali)
    hex("55")                             # push rbp
    hex("48 89 E5")                       # mov rbp, rsp
    hex("48 83 E4 F0")                    # and rsp, -16
    hex("48 83 EC 40")                    # sub rsp, 0x40
    hex("48 89 4C 24 30")                 # mov [rsp+0x30], rcx   (simpan alamat)
    hex("FF 15")                          # call [GetProcessHeap]
    relatif(OFF_IAT + 24)
    hex("48 89 C1")                       # mov rcx, rax          (heap)
    hex("31 D2")                          # xor edx, edx          (flags = 0)
    hex("4C 8B 44 24 30")                 # mov r8, [rsp+0x30]    (alamat)
    hex("FF 15")                          # call [HeapFree]
    relatif(OFF_IAT + 40)
    hex("48 89 EC")                       # mov rsp, rbp
    hex("5D")                             # pop rbp
    hex("C3")                             # ret

# api: dipanggil dengan 8 nilai di stack (indeks impor, a1..a7; a1 paling dalam). Mengatur rcx, rdx,
# r8, r9 dan argumen stack 5..7 sesuai konvensi Windows x64, memanggil [IAT + indeks*8], hasil di rax.
func rutinApi()
    hex("55")                             # push rbp
    hex("48 89 E5")                       # mov rbp, rsp
    hex("48 83 E4 F0")                    # and rsp, -16
    hex("48 83 EC 40")                    # sub rsp, 0x40
    hex("48 8B 4D 40")                    # mov rcx, [rbp+64]   a1
    hex("48 8B 55 38")                    # mov rdx, [rbp+56]   a2
    hex("4C 8B 45 30")                    # mov r8,  [rbp+48]   a3
    hex("4C 8B 4D 28")                    # mov r9,  [rbp+40]   a4
    hex("48 8B 45 20")                    # mov rax, [rbp+32]   a5
    hex("48 89 44 24 20")                 # mov [rsp+0x20], rax
    hex("48 8B 45 18")                    # mov rax, [rbp+24]   a6
    hex("48 89 44 24 28")                 # mov [rsp+0x28], rax
    hex("48 8B 45 10")                    # mov rax, [rbp+16]   a7
    hex("48 89 44 24 30")                 # mov [rsp+0x30], rax
    hex("48 8B 45 48")                    # mov rax, [rbp+72]   indeks impor
    hex("4C 8D 15")                       # lea r10, [IAT]
    relatif(OFF_IAT)
    hex("41 FF 14 C2")                    # call [r10 + rax*8]
    hex("48 89 EC")                       # mov rsp, rbp
    hex("5D")                             # pop rbp
    hex("C3")                             # ret

# ---------------------------------------------------------------- perintah (lewatan 2)
# lompatan jz ke depan untuk kondisi; hasil = posisi disp32 yang harus ditambal
func kondisi(teks string) int
    harusBool(ekspresiDari(teks))
    hex("58 48 85 C0")                    # pop rax; test rax, rax
    hex("0F 84")                          # jz rel32
    be p = kur
    d32(0)
    return p

# indentasi blok anak: baris berikutnya harus lebih menjorok daripada ind
func anak(ind int) int
    if si >= nStmt
        galat("blok kosong di akhir file")
    if inden[si] <= ind
        be noBaris = nomor[si]
        galat("blok kosong: baris setelahnya harus lebih menjorok")
    return inden[si]

# simpan nilai di rax ke variabel (buat slot baru kalau belum ada); tipe harus konsisten
#   Aturan seperti nrxl: di luar fungsi selalu global. Di dalam fungsi: lokal kalau sudah ada
#   (parameter / variabel lokal), kalau tidak global yang sudah ada diubah, kalau tidak buat lokal baru.
func simpanVar(nama string, tipe string)
    be idx = indexOf(scNama, nama)
    if idx >= 0
        if scTipe[idx] != tipe
            galat("variabel " nama " bertipe " scTipe[idx] ", tidak bisa diisi " tipe)
        hex("48 89 85")                   # mov [rbp + disp32], rax
        d32(scDisp[idx])
        return
    be gx = -1
    if globalOK and not paksaLokal
        be gx = indexOf(gNama, nama)
    if gx < 0 and globalOK and not dalamFungsi
        add(gNama, nama)
        add(gTipe, tipe)
        add(gKunci, 0)
        be gx = len(gNama) - 1
    if gx >= 0
        if gTipe[gx] != tipe
            galat("variabel " nama " bertipe " gTipe[gx] ", tidak bisa diisi " tipe)
        if gKunci[gx] == 1
            galat(nama " adalah lock, tidak bisa diubah")
        hex("48 89 05")                   # mov [rip + slot global], rax
        add(gloPos, kur)
        add(gloIdx, gx)
        d32(0)
        return
    be nLokal += 1                        # variabel lokal baru di dalam fungsi
    add(scNama, nama)
    add(scDisp, -8 * nLokal)
    add(scTipe, tipe)
    hex("48 89 85")
    d32(-8 * nLokal)

# ---- loop: break / continue / slot tersembunyi
func slotBaru() int
    be nLokal += 1
    return -8 * nLokal

func mulaiLoop()
    add(brkBase, len(brkPos))
    add(cntBase, len(cntPos))

# tambal semua break ke tujuanBreak dan semua continue ke tujuanCont, lalu tutup loop
func akhiriLoop(tujuanBreak int, tujuanCont int)
    be bb = takeLast(brkBase)
    loop len(brkPos) > bb
        tambal(takeLast(brkPos), tujuanBreak)
    be cb = takeLast(cntBase)
    loop len(cntPos) > cb
        tambal(takeLast(cntPos), tujuanCont)

# mov [rbp + d], rax   /   mov rax, [rbp + d]
func simpanSlot(d int)
    hex("48 89 85")
    d32(d)

func muatSlot(d int)
    hex("48 8B 85")
    d32(d)

# pecah argumen pada koma yang tidak berada di dalam kurung
func pecahArg(s string) list string
    be hasil list string
    be dlm = 0
    be mulai = 0
    for i in range(len(s))
        be ch = substr(s, i, 1)
        if ch == "(" or ch == "["
            be dlm += 1
        else if ch == ")" or ch == "]"
            be dlm -= 1
        else if ch == "," and dlm == 0
            add(hasil, trim(slice(s, mulai, i)))
            be mulai = i + 1
    add(hasil, trim(slice(s, mulai)))
    return hasil

# for v in range(...) / list / string : badan loop dikompilasi oleh pemanggil lewat blok(anak(ind))
func kompilasiFor(vNama string, eks string, ind int)
    be sA = slotBaru()
    be sB = slotBaru()
    be sC = slotBaru()
    be fin1 = 0
    be fin2 = 0
    be posTop = 0
    if substr(eks, 0, 6) == "range(" and slice(eks, -1) == ")"
        be ar = pecahArg(slice(eks, 6, len(eks) - 1))
        if len(ar) < 1 or len(ar) > 3
            galat("range butuh 1 sampai 3 argumen")
        # sA = awal, sB = batas, sC = langkah (semua dihitung sekali)
        if len(ar) == 1
            hex("31 C0")                  # xor eax, eax
            simpanSlot(sA)
            harusInt(ekspresiDari(ar[0]))
        else
            harusInt(ekspresiDari(ar[0]))
            hex("58")
            simpanSlot(sA)
            harusInt(ekspresiDari(ar[1]))
        hex("58")
        simpanSlot(sB)
        if len(ar) == 3
            harusInt(ekspresiDari(ar[2]))
            hex("58")
        else
            hex("B8 01 00 00 00")         # mov eax, 1
        simpanSlot(sC)
        be posTop = kur
        mulaiLoop()
        muatSlot(sA)                      # rax = hitungan
        hex("48 8B 8D")                   # mov rcx, [batas]
        d32(sB)
        hex("48 8B 95")                   # mov rdx, [langkah]
        d32(sC)
        hex("48 85 D2")                   # test rdx, rdx
        hex("0F 8F")                      # jg positif
        be pPos = kur
        d32(0)
        hex("48 39 C8")                   # (langkah negatif) cmp rax, rcx
        hex("0F 8E")                      # jle selesai
        be fin1 = kur
        d32(0)
        hex("E9")                         # jmp isi
        be pOk = kur
        d32(0)
        tambal(pPos, kur)                 # positif:
        hex("48 39 C8")                   # cmp rax, rcx
        hex("0F 8D")                      # jge selesai
        be fin2 = kur
        d32(0)
        tambal(pOk, kur)                  # isi:
        paksaLokalSet()
        simpanVar(vNama, "int")           # v = hitungan (rax)
        be paksaLokal = false
        be si += 1
        blok(anak(ind))
        be lblCont = kur
        muatSlot(sA)                      # hitungan += langkah
        hex("48 03 85")                   # add rax, [langkah]
        d32(sC)
        simpanSlot(sA)
        hex("E9")                         # jmp atas
        tambal(kur, posTop)
        be kur += 4
        tambal(fin1, kur)
        tambal(fin2, kur)
        akhiriLoop(kur, lblCont)
        return
    # list atau string
    be te = ekspresiDari(eks)
    if te != "string" and not tipeList(te)
        galat("for ... in hanya untuk range(...), list, dan string, bukan " te)
    hex("58")                             # pop rax
    simpanSlot(sA)                        # sA = list / string
    hex("31 C0")                          # xor eax, eax
    simpanSlot(sB)                        # sB = indeks
    be posTop = kur
    mulaiLoop()
    muatSlot(sB)                          # rax = indeks
    hex("48 8B 8D")                       # mov rcx, [sA]
    d32(sA)
    hex("48 3B 01")                       # cmp rax, [rcx]   (panjang list / string ada di offset 0)
    hex("0F 8D")                          # jge selesai
    be fin1 = kur
    d32(0)
    be tElem = "string"
    if te == "string"
        hex("0F B6 44 01 08")             # movzx eax, byte [rcx + rax + 8]
        hex("50")
        panggilNama("chr", 1)             # huruf sebagai string
        hex("58")
    else
        hex("48 8B 49 10")                # mov rcx, [rcx + 16]  (alamat data)
        hex("48 8B 04 C1")                # mov rax, [rcx + rax*8]
        be tElem = slice(te, 5)
    paksaLokalSet()
    simpanVar(vNama, tElem)
    be paksaLokal = false
    be si += 1
    blok(anak(ind))
    be lblCont2 = kur
    muatSlot(sB)
    hex("48 FF C0")                       # inc rax
    simpanSlot(sB)
    hex("E9")                             # jmp atas
    tambal(kur, posTop)
    be kur += 4
    tambal(fin1, kur)
    akhiriLoop(kur, lblCont2)

# variabel for di dalam fungsi selalu lokal; di luar fungsi tetap global
func paksaLokalSet()
    be paksaLokal = dalamFungsi

func blok(ind int)
    loop si < nStmt and inden[si] >= ind
        be noBaris = nomor[si]
        be berkNama = berk[si]
        if inden[si] > ind
            galat("indentasi tidak sesuai")
        be j = jenis[si]
        if j == "p"
            # print a b "c": semua nilai ditulis berjejer tanpa spasi, lalu satu baris baru
            be tok list string = pecah(arg[si])
            be tp = 0
            loop tp < len(tok)
                be tp1 = logika()
                if tp1 == "bool"
                    panggilNama("boolStr", 1)     # true / false sebagai string (hasil di stack)
                    be tp1 = "string"
                hex("58")                 # pop rax
                hex("E8")
                if tp1 == "int"
                    relatif(offCetak)
                else if tp1 == "string"
                    relatif(offStr)
                else
                    galat("print hanya untuk int, string, dan bool, bukan " tp1)
            hex("E8")                     # call cetakNL
            relatif(offCetakNL)
            be si += 1
        else if j == "D"
            # delete a, b : bebaskan memori variabel (string, list, type)
            for dn in split(arg[si], ",")
                be tdel = muatVar(trim(dn))
                if tipeList(tdel)
                    panggilNama("listHapus", 1)
                    hex("58")             # buang hasilnya
                else if tdel == "string" or cariStruct(tdel) >= 0
                    hex("59 E8")          # pop rcx; call free
                    relatif(offFree)
                else
                    hex("58")             # int/bool: tidak ada memori yang dibebaskan
            be si += 1
        else if j == "k"
            # lock NAMA = nilai   (konstanta global)
            if dalamFungsi
                galat("lock hanya boleh di luar fungsi")
            if indexOf(gNama, arg[si]) >= 0
                galat(arg[si] " sudah ada")
            be tp1 = ekspresiDari(isiB[si])
            hex("58")                     # pop rax
            simpanVar(arg[si], tp1)
            be gKunci[len(gKunci) - 1] = 1
            be si += 1
        else if j == "x"
            ekspresiDari(arg[si])
            hex("58")                     # pop rax (hasil dibuang)
            be si += 1
        else if j == "b"
            be tp1 = ekspresiDari(isiB[si])
            if isiC[si] != "" and isiC[si] != tp1
                galat("be " arg[si] " " isiC[si] " = ...: nilainya bertipe " tp1)
            hex("58")                     # pop rax
            simpanVar(arg[si], tp1)
            be si += 1
        else if j == "d"
            # deklarasi tanpa nilai: be x int / be ok bool / be s string / be xs list T  (nilai kosong)
            be td = isiB[si]
            if td == "int" or td == "bool"
                hex("31 C0")              # xor eax, eax   (0 / false)
            else if td == "string"
                add(litTeks, "")
                hex("48 8D 05")           # lea rax, ["" ]
                add(litPos, kur)
                add(litIdx, len(litTeks) - 1)
                d32(0)
            else if tipeList(td)
                panggilNama("listBaru", 0)
                hex("58")                 # pop rax
            else
                galat("tipe " td " tidak bisa dibuat tanpa nilai; pakai: be nama = " td "(nilai, ...)")
            simpanVar(arg[si], td)
            be si += 1
        else if j == "s"
            # be a.b[i].c = nilai
            simpanLval(arg[si], isiC[si])
            be si += 1
        else if j == "r"
            if not dalamFungsi
                galat("return hanya boleh di dalam fungsi")
            be tr1 = ekspresiDari(arg[si])
            if tr1 != curRet
                galat("fungsi ini mengembalikan " curRet ", bukan " tr1)
            hex("58")                     # pop rax
            hex("48 89 EC 5D C3")         # mov rsp, rbp; pop rbp; ret
            be si += 1
        else if j == "f"
            # definisi fungsi dikompilasi terpisah: lewati seluruh badannya
            be si += 1
            loop si < nStmt and inden[si] > ind
                be si += 1
        else if j == "l"
            be top = kur
            mulaiLoop()
            be pj = kondisi(arg[si])
            be si += 1
            blok(anak(ind))
            hex("E9")                     # jmp top
            tambal(kur, top)
            be kur += 4
            tambal(pj, kur)
            akhiriLoop(kur, top)
        else if j == "F"
            kompilasiFor(arg[si], isiB[si], ind)
        else if j == "br"
            if len(brkBase) == 0
                galat("break di luar loop")
            hex("E9")
            add(brkPos, kur)
            d32(0)
            be si += 1
        else if j == "ct"
            if len(cntBase) == 0
                galat("continue di luar loop")
            hex("E9")
            add(cntPos, kur)
            d32(0)
            be si += 1
        else if j == "i"
            be ak list int                # lompatan ke akhir rantai if
            be pj = kondisi(arg[si])
            be si += 1
            blok(anak(ind))
            be fin = false
            loop not fin
                if si < nStmt and inden[si] == ind and jenis[si] == "e"
                    hex("E9")
                    add(ak, kur)
                    d32(0)
                    tambal(pj, kur)
                    be si += 1
                    blok(anak(ind))
                    be fin = true
                else if si < nStmt and inden[si] == ind and jenis[si] == "ei"
                    hex("E9")
                    add(ak, kur)
                    d32(0)
                    tambal(pj, kur)
                    be noBaris = nomor[si]
                    be pj = kondisi(arg[si])
                    be si += 1
                    blok(anak(ind))
                else
                    tambal(pj, kur)
                    be fin = true
            for q in ak
                tambal(q, kur)
        else
            galat("'else' tanpa 'if' di atasnya")

# ---------------------------------------------------------------- baca sumber (lewatan 1)
func bacaSumber(nama string)
    be berkNama = nama
    be nb = 0
    for baris in split(replace(readFile(nama), "\r", ""), "\n")
        be nb += 1
        be b = trim(baris)
        if b == "" or substr(b, 0, 1) == "#"
            continue
        be noBaris = nb
        be sp = 0
        loop sp < len(baris) and substr(baris, sp, 1) == " "
            be sp += 1
        if substr(baris, sp, 1) == "\t"
            galat("pakai spasi untuk indentasi, bukan tab")
        if sp == 0
            be typeAktif = ""
        if typeAktif != "" and sp > 0
            # baris field di dalam "type": nama tipe
            be kf = split(b)
            if len(kf) < 2
                galat("field harus berbentuk: nama tipe")
            if contains(b, "=")
                galat("nilai bawaan field (hp int = 100) belum didukung")
            be sk = indexOf(structNama, typeAktif)
            be tf2 = join(slice(kf, 1), " ")
            if structFN[sk] == ""
                be structFN[sk] = kf[0]
                be structFT[sk] = tf2
            else
                be structFN[sk] = structFN[sk] + "," + kf[0]
                be structFT[sk] = structFT[sk] + ";" + tf2
            continue
        if substr(b, 0, 4) == "lib "
            continue                      # lib nrx_*.h diabaikan: fungsi file sudah ada di prelude
        if substr(b, 0, 5) == "type " and sp == 0
            be nt = trim(slice(b, 5))
            if nt == "" or not contains(HURUF, substr(nt, 0, 1)) or indexOf(structNama, nt) >= 0
                galat("nama type tidak valid atau sudah ada: " nt)
            add(structNama, nt)
            add(structFN, "")
            add(structFT, "")
            be typeAktif = nt
            continue
        add(nomor, nb)
        add(berk, nama)
        add(inden, sp)
        add(isiB, "")
        add(isiC, "")
        if substr(b, 0, 6) == "print "
            add(jenis, "p")
            add(arg, trim(slice(b, 6)))
        else if substr(b, 0, 3) == "be "
            be sisa = trim(slice(b, 3))
            be eq = indexOf(sisa, "=")
            be kata = split(sisa)
            if eq < 0 and len(kata) >= 2
                if len(kata) == 3 and kata[1] == "list"
                    be tdecl = "list " + kata[2]
                else if len(kata) == 2
                    be tdecl = kata[1]
                else
                    galat("bentuk yang benar: be nama tipe   atau   be nama list tipe")
                add(jenis, "d")
                add(arg, kata[0])
                be isiB[len(isiB) - 1] = tdecl
            else
                if eq < 1
                    galat("bentuk yang benar: be nama = ekspresi")
                be lhs = trim(slice(sisa, 0, eq))
                be nilai = trim(slice(sisa, eq + 1))
                be opAs = substr(lhs, len(lhs) - 1, 1)
                if contains("+-*/%", opAs)
                    # be x += 1  ==  be x = x + (1)
                    be lhs = trim(slice(lhs, 0, len(lhs) - 1))
                    be nilai = lhs + " " + opAs + " (" + nilai + ")"
                be pn = split(lhs)
                be tdecl2 = ""
                if len(pn) >= 2 and not contains(lhs, "[") and not contains(lhs, ".")
                    # be x int = 5
                    be lhs = pn[0]
                    be tdecl2 = join(slice(pn, 1), " ")
                if contains(lhs, "[") or contains(lhs, ".")
                    add(jenis, "s")
                    add(arg, lhs)
                    be isiC[len(isiC) - 1] = nilai
                else
                    if lhs == "" or not contains(HURUF, substr(lhs, 0, 1))
                        galat("nama variabel tidak valid: " lhs)
                    add(jenis, "b")
                    add(arg, lhs)
                    be isiB[len(isiB) - 1] = nilai
                    be isiC[len(isiC) - 1] = tdecl2
        else if substr(b, 0, 8) == "else if "
            add(jenis, "ei")
            add(arg, trim(slice(b, 8)))
        else if b == "else"
            add(jenis, "e")
            add(arg, "")
        else if substr(b, 0, 3) == "if "
            add(jenis, "i")
            add(arg, trim(slice(b, 3)))
        else if substr(b, 0, 5) == "loop "
            add(jenis, "l")
            add(arg, trim(slice(b, 5)))
        else if substr(b, 0, 7) == "return "
            add(jenis, "r")
            add(arg, trim(slice(b, 7)))
        else if substr(b, 0, 5) == "func "
            if sp != 0
                galat("func hanya boleh di paling kiri (tidak bersarang)")
            be ps = indexOf(b, "(")
            be rp = len(b) - 1 - indexOf(reverse(b), ")")
            if ps < 0 or rp < ps
                galat("bentuk yang benar: func nama(param tipe, ...) tipe")
            be fn = trim(slice(b, 5, ps))
            if fn == "" or not contains(HURUF, substr(fn, 0, 1))
                galat("nama fungsi tidak valid: " fn)
            if indexOf(funcNama, fn) >= 0
                galat("fungsi sudah ada: " fn)
            be tipeKembali = trim(slice(b, rp + 1))
            if tipeKembali == ""
                be tipeKembali = "int"
            be dalam = trim(slice(b, ps + 1, rp))
            be namaP list string
            be tipeP list string
            if dalam != ""
                for prm in split(dalam, ",")
                    be kt = split(trim(prm))
                    add(namaP, kt[0])
                    if len(kt) == 1
                        add(tipeP, "int")
                    else
                        add(tipeP, join(slice(kt, 1), " "))
            add(funcNama, fn)
            add(funcArity, len(namaP))
            add(funcStmt, len(jenis))
            add(funcPT, join(tipeP, ","))
            add(funcRet, tipeKembali)
            add(jenis, "f")
            add(arg, fn)
            be isiB[len(isiB) - 1] = join(namaP, ",")
        else if b == "break"
            add(jenis, "br")
            add(arg, "")
        else if b == "continue"
            add(jenis, "ct")
            add(arg, "")
        else if substr(b, 0, 4) == "for "
            be sisaF = trim(slice(b, 4))
            be inPos = indexOf(sisaF, " in ")
            if inPos < 1
                galat("bentuk yang benar: for nama in range(...) / list / string")
            add(jenis, "F")
            add(arg, trim(slice(sisaF, 0, inPos)))
            be isiB[len(isiB) - 1] = trim(slice(sisaF, inPos + 4))
        else if substr(b, 0, 7) == "delete "
            add(jenis, "D")
            add(arg, trim(slice(b, 7)))
        else if substr(b, 0, 5) == "lock "
            be sisaL = trim(slice(b, 5))
            be eqL = indexOf(sisaL, "=")
            if eqL < 1
                galat("bentuk yang benar: lock NAMA = nilai")
            be namaL = trim(slice(sisaL, 0, eqL))
            if namaL == "" or not contains(HURUF, substr(namaL, 0, 1)) or contains(namaL, " ")
                galat("nama lock tidak valid: " namaL)
            add(jenis, "k")
            add(arg, namaL)
            be isiB[len(isiB) - 1] = trim(slice(sisaL, eqL + 1))
        else if contains(HURUF, substr(b, 0, 1)) and contains(b, "(")
            add(jenis, "x")
            add(arg, b)
        else
            galat("perintah tidak dikenal: " b)
    be nStmt = len(jenis)

# ---------------------------------------------------------------- compiler
func kompilasi(sumber string, keluar string)
    bacaSumber("prelude.nrxl")
    if fileExists("pustaka.nrxl")
        bacaSumber("pustaka.nrxl")
    bacaSumber(sumber)
    for nm in ["listBaru", "listTambah", "listHapus", "strGabung", "strSama", "boolStr"]
        if indexOf(funcNama, nm) < 0
            print "prelude.nrxl tidak lengkap: fungsi " nm " tidak ada"
            exit(1)

    # --- denah isi section: tabel impor, nama impor, nama DLL, byte baris baru, lalu kode
    be impNama = ["GetStdHandle", "WriteFile", "ExitProcess", "GetProcessHeap", "HeapAlloc", "HeapFree", "CreateFileA", "ReadFile", "GetFileSize", "CloseHandle", "GetCommandLineA"]
    be offN list int
    be c = OFF_IAT + 8 * (NIMPOR + 1)
    for nmi in impNama
        add(offN, c)
        be c += ratakan(2 + len(nmi) + 1, 2)
    be offDll = c
    be c += 13
    be offNL = c
    be c += 1
    be offKode = ratakan(c, 16)

    # --- buffer: batas atas ukuran (kasar tapi aman)
    be batas = 4000
    for i in range(nStmt)
        be batas += 300 + 80 * (len(arg[i]) + len(isiB[i]) + len(isiC[i]))
    be B = newBuffer(RAW + ratakan(offKode + batas, 512))

    # --- tabel impor
    w32(sek(0), BASE_RVA + OFF_ILT)       # OriginalFirstThunk
    w32(sek(12), BASE_RVA + offDll)       # Name
    w32(sek(16), BASE_RVA + OFF_IAT)      # FirstThunk
    for k in range(NIMPOR)
        w64(sek(OFF_ILT + k * 8), BASE_RVA + offN[k])
        w64(sek(OFF_IAT + k * 8), BASE_RVA + offN[k])
        tulisTeks(sek(offN[k] + 2), impNama[k])
    tulisTeks(sek(offDll), "kernel32.dll")
    w8(sek(offNL), 10)

    # --- kode mesin
    be kur = offKode
    be offCetak = kur
    rutinCetak()
    be offTek = kur
    rutinCetakTeks()
    be offStr = kur
    rutinCetakStr()
    be offCetakNL = kur
    rutinCetakNL()
    be offAlloc = kur
    rutinAlloc()
    be offFree = kur
    rutinFree()
    be offApi = kur
    rutinApi()

    # program utama
    be entri = kur
    hex("55")                             # push rbp
    hex("48 89 E5")                       # mov rbp, rsp
    hex("48 81 EC")                       # sub rsp, imm32  (diisi nanti: ruang variabel + 0x40)
    be posRuang = kur
    d32(0)
    hex("B9 F5 FF FF FF")                 # mov ecx, -11   (STD_OUTPUT_HANDLE)
    hex("FF 15")                          # call [GetStdHandle]
    relatif(OFF_IAT)
    hex("48 89 C3")                       # mov rbx, rax   (handle disimpan di rbx)
    be si = 0
    be dalamFungsi = false
    be globalOK = true
    blok(0)
    hex("31 C9")                          # xor ecx, ecx
    hex("FF 15")                          # call [ExitProcess]
    relatif(OFF_IAT + 16)
    hex("CC")
    w32(sek(posRuang), ratakan(8 * nLokal, 16) + 64)

    # fungsi-fungsi
    be dalamFungsi = true
    for fk in range(len(funcNama))
        add(funcAddr, kur)
        be scNama list string
        be scDisp list int
        be scTipe list string
        be nLokal = 0
        be curRet = funcRet[fk]
        be globalOK = berk[funcStmt[fk]] != "prelude.nrxl" and berk[funcStmt[fk]] != "pustaka.nrxl"
        be ps2 = 0
        if funcArity[fk] > 0
            be tipeParam2 = split(funcPT[fk], ",")
            for pn in split(isiB[funcStmt[fk]], ",")
                add(scNama, trim(pn))
                add(scDisp, 16 + 8 * (funcArity[fk] - 1 - ps2))
                add(scTipe, tipeParam2[ps2])
                be ps2 += 1
        hex("55")                         # push rbp
        hex("48 89 E5")                   # mov rbp, rsp
        hex("48 81 EC")                   # sub rsp, imm32 (ruang variabel lokal)
        be posR2 = kur
        d32(0)
        be si = funcStmt[fk] + 1
        be noBaris = nomor[funcStmt[fk]]
        be berkNama = berk[funcStmt[fk]]
        blok(anak(0))
        hex("31 C0")                      # xor eax, eax  (return 0 kalau tidak ada return)
        hex("48 89 EC 5D C3")             # mov rsp, rbp; pop rbp; ret
        w32(sek(posR2), ratakan(8 * nLokal, 16))
    # tambal semua pemanggilan fungsi
    for k in range(len(callPos))
        tambal(callPos[k], funcAddr[callFn[k]])

    # literal string: [panjang 8 byte][isi][0], diletakkan setelah semua kode
    be be8 = ratakan(kur, 8)
    be kur = be8
    be litAlamat list int
    for lt in litTeks
        add(litAlamat, kur)
        w64(sek(kur), len(lt))
        tulisTeks(sek(kur + 8), lt)
        be kur += ratakan(len(lt) + 9, 8)
    for k in range(len(litPos))
        tambal(litPos[k], litAlamat[litIdx[k]])
    # slot variabel global (8 byte masing-masing, awalnya nol)
    be kur = ratakan(kur, 8)
    be gBase = kur
    be kur += 8 * len(gNama)
    for k in range(len(gloPos))
        tambal(gloPos[k], gBase + 8 * gloIdx[k])

    # --- header DOS dan PE (setelah ukuran kode diketahui)
    be ukSection = kur
    w32(sek(posFreeLim), ukSection)       # batas image untuk free()
    be rawSection = ratakan(ukSection, 512)
    be total = RAW + rawSection
    w8(0, 77)                             # 'M'
    w8(1, 90)                             # 'Z'
    w32(60, 64)                           # e_lfanew -> header PE di 0x40
    w32(64, 17744)                        # "PE\0\0"
    w16(68, 34404)                        # Machine = AMD64 (0x8664)
    w16(70, 1)                            # jumlah section
    w16(84, 240)                          # SizeOfOptionalHeader = 0xF0
    w16(86, 34)                           # EXE | LARGE_ADDRESS_AWARE (0x0022)
    be o = 88                             # Optional header (0x58)
    w16(o, 523)                           # PE32+ (0x20B)
    w8(o + 2, 1)
    w32(o + 4, rawSection)                # SizeOfCode
    w32(o + 16, BASE_RVA + entri)         # AddressOfEntryPoint
    w32(o + 20, BASE_RVA)                 # BaseOfCode
    w64(o + 24, 5368709120)               # ImageBase = 0x140000000
    w32(o + 32, 4096)                     # SectionAlignment
    w32(o + 36, 512)                      # FileAlignment
    w16(o + 40, 6)                        # versi OS minimum
    w16(o + 48, 6)                        # versi subsystem
    w32(o + 56, BASE_RVA + ratakan(ukSection, 4096))   # SizeOfImage
    w32(o + 60, RAW)                      # SizeOfHeaders
    w16(o + 68, 3)                        # Subsystem = console
    w64(o + 72, 1048576)                  # stack reserve (1 MB)
    w64(o + 80, 4096)                     # stack commit
    w64(o + 88, 1048576)                  # heap reserve
    w64(o + 96, 4096)                     # heap commit
    w32(o + 108, 16)                      # jumlah data directory
    w32(o + 120, BASE_RVA)                # directory 1: tabel impor
    w32(o + 124, 40)
    w32(o + 208, BASE_RVA + OFF_IAT)      # directory 12: IAT
    w32(o + 212, 8 * (NIMPOR + 1))
    be s = 328                            # section header (0x148)
    w8(s, 46)                             # ".text"
    w8(s + 1, 116)
    w8(s + 2, 101)
    w8(s + 3, 120)
    w8(s + 4, 116)
    w32(s + 8, ukSection)                 # VirtualSize
    w32(s + 12, BASE_RVA)                 # VirtualAddress
    w32(s + 16, rawSection)               # SizeOfRawData
    w32(s + 20, RAW)                      # PointerToRawData
    w32(s + 36, 3758096480)               # CODE | INIT_DATA | EXEC | READ | WRITE (0xE0000060)

    # --- tulis ke disk (byte mentah)
    be h = CreateFileA(keluar, 1073741824, 0, 0, 2, 128, 0)
    be tertulis = newBuffer(8)
    WriteFile(h, B, total, tertulis, 0)
    CloseHandle(h)
    print "Selesai: " keluar " (" total " byte, " nStmt " perintah, " len(funcNama) " fungsi, " len(litTeks) " literal)"

# ---------------------------------------------------------------- program utama
print "=== nrxc (tahap 5): compiler nrxl -> .exe tanpa C ==="
be sumber = ask "File sumber [contoh.nrxl]: "
be sumber = trim(sumber)
if sumber == ""
    be sumber = "contoh.nrxl"
be keluar = ask "Nama .exe [hasil.exe]: "
be keluar = trim(keluar)
if keluar == ""
    be keluar = "hasil.exe"
kompilasi(sumber, keluar)
